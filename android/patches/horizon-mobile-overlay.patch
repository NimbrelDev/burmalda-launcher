+/// Where `Options::read` finds the installed resources on Android: the
+/// launcher's copy on the shared storage (`files/resources`).
+pub(crate) fn resources_dir() -> std::path::PathBuf {
+    std::path::PathBuf::from("/sdcard/Android/data/org.horizon.client/files/resources")
+}
+
+/// The Android app handle `android_main` received, for the event loop
+/// builders (winit needs it before it can create its event loop).
+static ANDROID_APP: std::sync::OnceLock<android_activity::AndroidApp> =
+    std::sync::OnceLock::new();
+
+/// Stores the Android app handle; called from `android_main` (via the
+/// one-line delegate in `game.rs`).
+pub(crate) fn set_android_app(app: android_activity::AndroidApp) {
+    let _ = ANDROID_APP.set(app);
+}
+
+/// Builds and runs the winit event loop on Android: unlike desktop, the
+/// builder must receive the `AndroidApp` handle `android_main` got.
+pub(crate) fn run_android_event_loop<T: winit::application::ApplicationHandler>(
+    app: &mut T,
+) -> Result<()> {
+    use winit::platform::android::EventLoopBuilderExtAndroid;
+    if let Some(android_app) = ANDROID_APP.get() {
+        Ok(EventLoop::builder()
+            .with_android_app(android_app.clone())
+            .build()?
+            .run_app(app)?)
+    } else {
+        Ok(EventLoop::new()?.run_app(app)?)
+    }
+}
+
+/// The Android back gesture (and back button) arrives as the browser Back
+/// key: remap it to Escape so every screen treats it as "go back one step",
+/// like the physical keyboard's Escape would.
+pub(crate) fn remap_back_key(mut event: WindowEvent) -> WindowEvent {
+    if let WindowEvent::KeyboardInput { event: ref mut key_event, .. } = event {
+        let is_back = matches!(key_event.physical_key, PhysicalKey::Code(KeyCode::BrowserBack))
+            || matches!(
+                &key_event.logical_key,
+                winit::keyboard::Key::Named(
+                    winit::keyboard::NamedKey::GoBack | winit::keyboard::NamedKey::BrowserBack
+                )
+            );
+        if is_back {
+            key_event.physical_key = PhysicalKey::Code(KeyCode::Escape);
+            key_event.logical_key = winit::keyboard::Key::Named(winit::keyboard::NamedKey::Escape);
+        }
+    }
+    event
+}
+
+/// Whether the cursor is parked offscreen (the `(-1000, -1000)` sentinel) or
+/// still at its default `(0, 0)` origin, i.e. it was never placed by a real
+/// touch on this screen. A legitimate touch can land exactly on the pixel
+/// column/row 0 or on the opposite screen edge, so the test is "strictly
+/// outside the screen bounds" (plus the exact origin), never "on the
+/// boundary".
+fn cursor_uninitialized(cursor: (f32, f32), sw: f32, sh: f32) -> bool {
+    cursor.0 < 0.0
+        || cursor.1 < 0.0
+        || cursor.0 > sw
+        || cursor.1 > sh
+        || (cursor.0 == 0.0 && cursor.1 == 0.0)
+}
+
+/// Draws a filled regular polygon (approximating a circle) into the HUD batch.
+fn draw_circle_fan(
+    atlas: &HudAtlas,
+    batch: &mut HudBatch,
+    cx: f32,
+    cy: f32,
+    r: f32,
+    color: u32,
+) {
+    const SEGMENTS: usize = 16;
+    let mut pts = [[0.0f32; 2]; SEGMENTS];
+    for i in 0..SEGMENTS {
+        let angle = (i as f32) * (std::f32::consts::TAU / SEGMENTS as f32);
+        pts[i] = [cx + r * angle.cos(), cy + r * angle.sin()];
+    }
+    // Draw 8 quads pairing adjacent triangles around center
+    for i in (0..SEGMENTS).step_by(2) {
+        let p0 = pts[i];
+        let p1 = pts[(i + 1) % SEGMENTS];
+        let p2 = pts[(i + 2) % SEGMENTS];
+        batch.fill_quad(atlas, [[cx, cy], p0, p1, p2], color);
+    }
+}
+
+/// Draws an outline ring for a circle into the HUD batch.
+fn draw_circle_ring(
+    atlas: &HudAtlas,
+    batch: &mut HudBatch,
+    cx: f32,
+    cy: f32,
+    r_inner: f32,
+    r_outer: f32,
+    color: u32,
+) {
+    const SEGMENTS: usize = 16;
+    for i in 0..SEGMENTS {
+        let a0 = (i as f32) * (std::f32::consts::TAU / SEGMENTS as f32);
+        let a1 = ((i + 1) as f32) * (std::f32::consts::TAU / SEGMENTS as f32);
+        let p0 = [cx + r_inner * a0.cos(), cy + r_inner * a0.sin()];
+        let p1 = [cx + r_outer * a0.cos(), cy + r_outer * a0.sin()];
+        let p2 = [cx + r_outer * a1.cos(), cy + r_outer * a1.sin()];
+        let p3 = [cx + r_inner * a1.cos(), cy + r_inner * a1.sin()];
+        batch.fill_quad(atlas, [p0, p1, p2, p3], color);
+    }
+}
