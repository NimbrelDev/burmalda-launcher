+
+#[cfg(target_os = "android")]
+#[allow(unsafe_code)]
+#[unsafe(no_mangle)]
+fn android_main(app: android_activity::AndroidApp) {
+    let home = std::path::PathBuf::from("/sdcard/Android/data/org.horizon.client/files");
+    let _ = std::fs::create_dir_all(&home);
+    let _ = std::env::set_current_dir(&home);
+    crate::logging::init(&home, "Render thread");
+    log::info!("Horizon Android starting on ARM64...");
+    // Launcher-requested resource installation (the desktop launcher's
+    // "Download" button, mobile edition): the flag file selects the version,
+    // progress goes to install-progress.txt, and the process exits without
+    // entering the game so the launcher can read the result and relaunch.
+    if crate::official_install::install_requested(&home) {
+        log::info!("install-assets.flag present: installing official resources");
+        let _ = crate::official_install::install(&home, &app);
+        crate::logging::flush();
+        std::process::exit(0);
+    }
+    // Nothing installed and nothing requested: exit cleanly with a message
+    // instead of booting the renderer into a missing-resources error.
+    if !crate::official_install::resources_ready(&home) {
+        log::error!("resources not installed, download from launcher (restart with install-assets.flag)");
+        crate::logging::flush();
+        std::process::exit(0);
+    }
+    crate::game::set_android_app(app);
+    if let Err(error) = crate::game::run() {
+        log::error!("Horizon Android fatal error: {error}");
+    }
+    crate::logging::flush();
+    // winit's event loop can only ever be created once per process (Android);
+    // never return from android_main so a relaunch always gets a fresh process.
+    std::process::exit(0);
+}
