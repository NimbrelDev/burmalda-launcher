+        let kb_text = "ABC";
+        let ktw = HudBatch::text_width(atlas, kb_text);
+        batch.text(
+            atlas,
+            kb_text,
+            kb_center.0 - ktw / 2.0,
+            kb_center.1 - 4.0,
+            rgba(255, 255, 255, 230),
+            false,
