new file mode 100644
index 0000000..a1c24a4
--- /dev/null
+++ b/crates/horizon-client/src/mobile.rs
@@ -0,0 +1,2079 @@
+#![cfg(target_os = "android")]
+//! Android mobile touch controls: virtual joystick, camera look swipe,
+//! minimal HUD buttons (joystick, jump, inventory, chat, keyboard), gesture
+//! timers, hotbar selection, vanilla 1:1 inventory LMB/RMB mechanics & drag,
+//! cursor hover glow fix, a mini side keyboard panel (F / abc / 123 tabs)
+//! for game keys, and the Android system keyboard (IME) raised for the
+//! engine's text fields (chat, commands, signs, books, renames, title
+//! fields) — whose text arrives through the same
+//! `WindowEvent::KeyboardInput` path a physical keyboard uses.
+
+use crate::{
+    game::{books, Game, Screen},
+    hud::{HudAtlas, HudBatch, rgba},
+    title::Action,
+    Result,
+};
+use std::time::Instant;
+use winit::{
+    event::{MouseButton, Touch, TouchPhase, WindowEvent},
+    event_loop::{ActiveEventLoop, EventLoop},
+    keyboard::{KeyCode, PhysicalKey},
+};
+
+/// Inventory cursor speed: GUI pixels of cursor travel per GUI pixel of
+/// finger travel (the reference fork's default virtual-mouse sensitivity).
+const INV_CURSOR_SENSITIVITY: f32 = 1.0;
+/// Finger travel (squared, GUI px) that marks a gesture as "cursor move":
+/// after it, the release can no longer fire a tap click (reference: 3 px).
+const INV_DRAG_DIST_SQ: f32 = 3.0 * 3.0;
+/// Stationary hold duration that fires a Right click (half stack / place
+/// one; with movement it becomes the RMB distribute sweep). Reference: 500ms.
+const INV_HOLD_RIGHT_MS: u128 = 500;
+
+/// A second menu press within this window of the previous one counts as a
+/// bounce of the same tap, not a new click (one tap = one activation).
+const MENU_BOUNCE_MS: u128 = 150;
+/// Menu bounce radius: GUI px between the presses of the same tap.
+const MENU_BOUNCE_DIST: f32 = 24.0;
+/// Safe zones (GUI px): menu scroll drags only start between the top
+/// cutout/status-bar band and the bottom navigation-bar band.
+const MENU_SAFE_TOP: f32 = 32.0;
+const MENU_SAFE_BOTTOM: f32 = 32.0;
+
+/// Internal state tracking mobile touch interactions.
+#[derive(Default)]
+pub struct MobileTouchState {
+    // 1. Movement joystick
+    pub stick_id: Option<u64>,
+    pub stick_origin: (f32, f32),
+    pub stick_offset: (f32, f32),
+
+    // 2. Jump button
+    pub jump_id: Option<u64>,
+
+    // 3. Camera look & continuous mining
+    pub look_id: Option<u64>,
+    pub look_prev: (f32, f32),
+    pub look_start: (f32, f32),
+    pub look_start_time: Option<Instant>,
+    pub look_moved_dist: f32,
+    pub is_mining: bool,
+
+    // 4. Inventory touch & drag state (virtual-mouse model, reference UX)
+    pub inv_touch_id: Option<u64>,
+    pub inv_start_pos: (f32, f32),
+    /// Last GUI-space position of the cursor finger (for relative movement).
+    pub inv_last: (f32, f32),
+    pub inv_start_time: Option<Instant>,
+    pub inv_moved: bool,
+    pub inv_pressed: bool,
+    pub inv_is_right: bool,
+    /// A second finger acting as a held Left mouse button (the reference
+    /// fork's on-screen LMB/RMB buttons, ported logic-only): press it, move
+    /// the cursor with the first finger — that is the stack drag.
+    pub inv_lmb_id: Option<u64>,
+
+    /// The camera-look gesture that started on the inventory button's
+    /// enlarged corner hit zone. The gesture still works as a camera swipe,
+    /// but it must never start continuous mining, and a quick tap on it
+    /// opens the inventory instead of interacting with the world (taps near
+    /// the top-right corner used to leak through as random interacts).
+    pub inv_corner_id: Option<u64>,
+
+    // 5. Mini side keyboard (touch) + system IME
+    /// The mini side panel is drawn and its taps are keys.
+    pub osk_open: bool,
+    /// The panel's active tab (F / abc / 123).
+    osk_tab: OskTab,
+    /// One-shot shift: the next letter is upper case.
+    pub osk_shift: bool,
+    /// Whether the Android system keyboard (IME) is currently raised for a
+    /// focused text field; toggled only on transitions.
+    pub osk_ime: bool,
+    /// The active menu scroll drag: the finger's touch id and its last GUI
+    /// y. Only set when a press on an options screen hit empty space (no
+    /// widget), so scrolling never fights widget interaction.
+    pub menu_scroll: Option<(u64, f32)>,
+    /// The last menu press (time and GUI position): a bounced second press
+    /// of the same tap — same spot within a beat — is swallowed, so one
+    /// tap activates exactly one menu item even when the first press
+    /// switched the screen under the finger.
+    pub last_menu_press: Option<(Instant, f32, f32)>,
+    /// Key outputs waiting to be flushed into the focused text field
+    /// (drained after every touch event).
+    osk_queue: Vec<OskOut>,
+
+    /// Whether the last touch event (or tick) saw gameplay. A flip of this
+    /// flag means the screen changed (inventory opened or closed, a
+    /// container, death, ...): every gesture that started under the
+    /// previous screen is invalid and must be dropped before the next
+    /// event is routed, or a finger still on the glass feeds its stale
+    /// last touch position into the camera and the view snaps towards
+    /// that corner.
+    pub was_gameplay: bool,
+}
+
+static TOUCH_STATE: std::sync::Mutex<MobileTouchState> =
+    std::sync::Mutex::new(MobileTouchState {
+        stick_id: None,
+        stick_origin: (60.0, 0.0),
+        stick_offset: (0.0, 0.0),
+        jump_id: None,
+        look_id: None,
+        look_prev: (0.0, 0.0),
+        look_start: (0.0, 0.0),
+        look_start_time: None,
+        look_moved_dist: 0.0,
+        is_mining: false,
+        inv_touch_id: None,
+        inv_start_pos: (0.0, 0.0),
+        inv_last: (0.0, 0.0),
+        inv_start_time: None,
+        inv_moved: false,
+        inv_pressed: false,
+        inv_is_right: false,
+        inv_lmb_id: None,
+        inv_corner_id: None,
+        osk_open: false,
+        osk_tab: OskTab::Func,
+        osk_shift: false,
+        osk_ime: false,
+        menu_scroll: None,
+        last_menu_press: None,
+        osk_queue: Vec::new(),
+        was_gameplay: false,
+    });
+
+impl Game<'_> {
+    /// Main entry point for mobile touch event routing.
+    pub(crate) fn handle_mobile_touch(&mut self, touch: Touch) {
+        let (sw, sh, scale) = if let Some(r) = &self.renderer {
+            let b = HudBatch::new([r.config.width, r.config.height]);
+            (b.width, b.height, b.scale)
+        } else {
+            (854.0, 480.0, 2.0)
+        };
+
+        let gx = touch.location.x as f32 / scale;
+        let gy = touch.location.y as f32 / scale;
+
+        let is_in_game = self.screen == Screen::Playing
+            && self.title.is_none()
+            && !self.is_overlay_open();
+
+        // The screen changed since the last touch event (the inventory was
+        // opened or closed, a container opened from a gameplay tap, the
+        // player died, ...). Drop every gesture started under the previous
+        // screen BEFORE routing this event: a finger still on the glass
+        // would otherwise integrate one camera delta spanning its whole
+        // stale travel (the view swings towards the corner that finger
+        // last visited), keep mining, or keep its movement keys stuck.
+        if let Ok(mut state) = TOUCH_STATE.lock() {
+            if state.was_gameplay != is_in_game {
+                state.was_gameplay = is_in_game;
+                self.reset_mobile_gestures(&mut state);
+                if !is_in_game {
+                    // Entering a screen: the cursor starts centred — never
+                    // at the parked offscreen spot or (0, 0), where slot
+                    // hit-testing would resolve to the top-left slot.
+                    if matches!(self.screen, Screen::Inventory | Screen::Creative) {
+                        self.cursor = (sw / 2.0, sh / 2.0);
+                    }
+                } else {
+                    // Back to gameplay: park the cursor offscreen again
+                    // (same as tick_mobile) so no hover glow sticks.
+                    self.cursor = (-1000.0, -1000.0);
+                }
+            }
+            self.sync_mobile_keyboard(&mut state);
+        }
+
+        if is_in_game {
+            self.handle_gameplay_touch(touch, gx, gy, sw, sh, scale);
+        } else {
+            self.handle_menu_touch(touch, gx, gy, sw, sh, scale);
+        }
+    }
+
+    /// Drops every transient gesture (joystick, camera swipe, mining, jump,
+    /// inventory drag). Called when the screen changes so nothing started
+    /// under one screen can leak into another one.
+    fn reset_mobile_gestures(&mut self, state: &mut MobileTouchState) {
+        if state.stick_id.take().is_some() {
+            for key in [KeyCode::KeyW, KeyCode::KeyS, KeyCode::KeyA, KeyCode::KeyD] {
+                self.keys.remove(&key);
+            }
+        }
+        state.stick_offset = (0.0, 0.0);
+        if state.jump_id.take().is_some() {
+            self.keys.remove(&KeyCode::Space);
+        }
+        if state.is_mining {
+            let _ = self.play_mouse(MouseButton::Left, false);
+        }
+        // Release any held inventory mouse buttons (RMB hold-drag, the
+        // second-finger LMB) before clearing the state, so a screen change
+        // never leaves a virtual button stuck down.
+        if state.inv_pressed {
+            let button = if state.inv_is_right {
+                MouseButton::Right
+            } else {
+                MouseButton::Left
+            };
+            let _ = self.dispatch_menu_mouse(false, button, None);
+        }
+        if state.inv_lmb_id.take().is_some() {
+            let _ = self.dispatch_menu_mouse(false, MouseButton::Left, None);
+        }
+        state.look_id = None;
+        state.look_prev = (0.0, 0.0);
+        state.look_start = (0.0, 0.0);
+        state.look_start_time = None;
+        state.look_moved_dist = 0.0;
+        state.is_mining = false;
+        state.inv_touch_id = None;
+        state.inv_start_pos = (0.0, 0.0);
+        state.inv_last = (0.0, 0.0);
+        state.inv_start_time = None;
+        state.inv_moved = false;
+        state.inv_pressed = false;
+        state.inv_is_right = false;
+        state.inv_corner_id = None;
+        state.menu_scroll = None;
+    }
+
+    /// Handles gameplay touch events: joystick, jump, inventory, hotbar, camera look & gestures.
+    fn handle_gameplay_touch(
+        &mut self,
+        touch: Touch,
+        gx: f32,
+        gy: f32,
+        sw: f32,
+        sh: f32,
+        scale: f32,
+    ) {
+        // The mini side panel (when open) owns its taps before any gesture
+        // starts, but blocks nothing else: touches outside it fall through
+        // to the game. (Before the state lock: mobile_panel_touch locks
+        // TOUCH_STATE itself.)
+        if self.mobile_panel_touch(&touch, gx, gy, sw, sh) {
+            return;
+        }
+
+        let mut state = TOUCH_STATE.lock().unwrap();
+
+        match touch.phase {
+            TouchPhase::Started => {
+                // 1. Panel edge button (right edge, vertically centred:
+                // center at sw - 14.0, sh * 0.4). Toggles the mini keyboard
+                // panel; the game stays fully usable while it is open.
+                let pb_dx = gx - (sw - 14.0);
+                let pb_dy = gy - (sh * 0.4);
+                if pb_dx * pb_dx + pb_dy * pb_dy <= 26.0 * 26.0 {
+                    state.osk_open = !state.osk_open;
+                    if !state.osk_open {
+                        self.mobile_keyboard_clear_mods();
+                    }
+                    return;
+                }
+
+                // 2. Inventory button (top-right: center at sw - 30.0, 26.0,
+                // drawn with an 18 px radius). The hit zone is deliberately
+                // much larger (45 px) than the drawing: the button sits in
+                // the corner, where a missed tap used to fall through to the
+                // camera gesture and a quick tap then interacted with
+                // whatever the crosshair hit. The zone still starts a normal
+                // camera-look gesture so swipes are unaffected — but it is
+                // tagged, never mines, and a quick tap on it opens the
+                // inventory (handled at release below).
+                let inv_dx = gx - (sw - 30.0);
+                let inv_dy = gy - 26.0;
+                if (inv_dx * inv_dx + inv_dy * inv_dy).sqrt() <= 45.0
+                    && state.look_id.is_none()
+                {
+                    state.look_id = Some(touch.id);
+                    let screen_pos = (touch.location.x as f32, touch.location.y as f32);
+                    state.look_prev = screen_pos;
+                    state.look_start = screen_pos;
+                    state.look_start_time = Some(Instant::now());
+                    state.look_moved_dist = 0.0;
+                    state.is_mining = false;
+                    state.inv_corner_id = Some(touch.id);
+                    return;
+                }
+
+                // 3. Jump button (bottom-right: center at sw - 48.0, sh - 48.0)
+                let jump_dx = gx - (sw - 48.0);
+                let jump_dy = gy - (sh - 48.0);
+                if (jump_dx * jump_dx + jump_dy * jump_dy).sqrt() <= 32.0 {
+                    // Ignore a second finger: the held jump finger owns the
+                    // button until it releases.
+                    if state.jump_id.is_none() {
+                        state.jump_id = Some(touch.id);
+                        self.keys.insert(KeyCode::Space);
+                    }
+                    return;
+                }
+
+                // 4. Chat button (top-right under the INV button: center at
+                // sw - 30.0, 82.0). A quick tap opens the chat (the vanilla
+                // T key); the system keyboard (IME) is raised over it by
+                // the keyboard sync, so chat and commands can be typed.
+                let kb_dx = gx - (sw - 30.0);
+                let kb_dy = gy - 82.0;
+                if (kb_dx * kb_dx + kb_dy * kb_dy).sqrt() <= 30.0 {
+                    self.keys.insert(KeyCode::KeyT);
+                    let _ = self.key_pressed(KeyCode::KeyT);
+                    self.keys.remove(&KeyCode::KeyT);
+                    return;
+                }
+
+                // 5. Hotbar slot touch (bottom-center). The hotbar sprite is
+                // 182 px wide for 9 slots (20.222.. px each, hud_layout.rs):
+                // derive the slot width from that actual span instead of
+                // rounding, or the last slot mis-hits by half a slot.
+                let hotbar_center = sw / 2.0;
+                let hx0 = hotbar_center - 91.0;
+                let hx1 = hotbar_center + 91.0;
+                if gy >= (sh - 28.0) && gx >= hx0 && gx <= hx1 {
+                    let slot_w = (hx1 - hx0) / 9.0;
+                    let slot = (((gx - hx0) / slot_w).floor() as usize).min(8);
+                    self.selected = slot;
+                    return;
+                }
+
+                // 6. Movement virtual joystick (left half of screen)
+                if gx < sw * 0.48 {
+                    // Ignore a second finger: the active joystick owns the
+                    // left half until it releases (overwriting it orphaned
+                    // the first thumb's drag and its key releases).
+                    if state.stick_id.is_none() {
+                        state.stick_id = Some(touch.id);
+                        let default_center = (60.0, sh - 60.0);
+                        let dist_to_default = ((gx - default_center.0).powi(2)
+                            + (gy - default_center.1).powi(2))
+                        .sqrt();
+                        state.stick_origin = if dist_to_default <= 65.0 {
+                            default_center
+                        } else {
+                            (gx, gy)
+                        };
+                        state.stick_offset = (0.0, 0.0);
+                    }
+                    return;
+                }
+
+                // 7. Camera look & mining/attack gestures (right half of
+                // screen). Ignore a second finger while one look gesture is
+                // active: overwriting `look_id` orphaned the first finger's
+                // swipe (its release then never matched) — the same bug
+                // class as the inventory drag.
+                if gx >= sw * 0.48 && state.look_id.is_none() {
+                    state.look_id = Some(touch.id);
+                    let screen_pos = (touch.location.x as f32, touch.location.y as f32);
+                    state.look_prev = screen_pos;
+                    state.look_start = screen_pos;
+                    state.look_start_time = Some(Instant::now());
+                    state.look_moved_dist = 0.0;
+                    state.is_mining = false;
+                    return;
+                }
+            }
+
+            TouchPhase::Moved => {
+                // Movement joystick update
+                if state.stick_id == Some(touch.id) {
+                    let dx = gx - state.stick_origin.0;
+                    let dy = gy - state.stick_origin.1;
+                    let dist = (dx * dx + dy * dy).sqrt();
+                    let max_r = 38.0;
+                    let clamped = if dist > max_r {
+                        (dx / dist * max_r, dy / dist * max_r)
+                    } else {
+                        (dx, dy)
+                    };
+                    state.stick_offset = clamped;
+
+                    let deadzone = 10.0;
+                    if clamped.1 < -deadzone {
+                        self.keys.insert(KeyCode::KeyW);
+                    } else {
+                        self.keys.remove(&KeyCode::KeyW);
+                    }
+                    if clamped.1 > deadzone {
+                        self.keys.insert(KeyCode::KeyS);
+                    } else {
+                        self.keys.remove(&KeyCode::KeyS);
+                    }
+                    if clamped.0 < -deadzone {
+                        self.keys.insert(KeyCode::KeyA);
+                    } else {
+                        self.keys.remove(&KeyCode::KeyA);
+                    }
+                    if clamped.0 > deadzone {
+                        self.keys.insert(KeyCode::KeyD);
+                    } else {
+                        self.keys.remove(&KeyCode::KeyD);
+                    }
+                    return;
+                }
+
+                // Camera swipe update
+                if state.look_id == Some(touch.id) {
+                    let cur = (touch.location.x as f32, touch.location.y as f32);
+                    let dx = cur.0 - state.look_prev.0;
+                    let dy = cur.1 - state.look_prev.1;
+
+                    // Android reuses touch ids, and a gesture interrupted by
+                    // a screen change leaves `look_prev` at its old spot: one
+                    // event then spans most of the screen. A single jump that
+                    // big is never a real swipe — re-anchor here and drop it
+                    // instead of swinging the camera to a screen corner.
+                    let (pw, ph) = (sw * scale, sh * scale);
+                    if dx * dx + dy * dy > (0.6 * pw.min(ph)).powi(2) {
+                        state.look_prev = cur;
+                        state.look_start = cur;
+                        state.look_start_time = Some(Instant::now());
+                        state.look_moved_dist = 0.0;
+                        return;
+                    }
+
+                    state.look_moved_dist += (dx * dx + dy * dy).sqrt();
+                    state.look_prev = cur;
+
+                    // Smooth camera turning (responsive mobile look). Deltas
+                    // arrive in physical pixels, whose count per finger
+                    // distance grows with display density: dividing by the
+                    // GUI scale (which tracks the surface size/density) makes
+                    // a swipe turn the camera by the same angle on any phone,
+                    // tablet or aspect ratio. LOOK_SENSITIVITY is expressed
+                    // per GUI pixel; 0.92 * 3 preserves the previously tuned
+                    // 0.92-per-physical-pixel feel on the reference GUI
+                    // scale 3.
+                    const LOOK_SENSITIVITY: f32 = 0.92 * 3.0;
+                    self.mouse.on_move(
+                        0.0,
+                        0.0,
+                        ((dx / scale) * LOOK_SENSITIVITY) as f64,
+                        ((dy / scale) * LOOK_SENSITIVITY) as f64,
+                        true,
+                        true,
+                    );
+
+                    // Only stop mining if finger performs a sudden fast
+                    // flick/swipe. The speed threshold is in GUI pixels per
+                    // event (= 600 physical px^2 at GUI scale 3), so the
+                    // flick that stops mining needs the same finger speed at
+                    // any density.
+                    const MINING_FLICK_SPEED_SQ: f32 = 600.0 / (3.0 * 3.0);
+                    let speed_sq = (dx * dx + dy * dy) / (scale * scale);
+                    if state.is_mining && speed_sq > MINING_FLICK_SPEED_SQ {
+                        state.is_mining = false;
+                        let _ = self.play_mouse(MouseButton::Left, false);
+                    }
+                    return;
+                }
+            }
+
+            TouchPhase::Ended | TouchPhase::Cancelled => {
+                // Jump button release
+                if state.jump_id == Some(touch.id) {
+                    state.jump_id = None;
+                    self.keys.remove(&KeyCode::Space);
+                }
+
+                // Joystick release
+                if state.stick_id == Some(touch.id) {
+                    state.stick_id = None;
+                    state.stick_offset = (0.0, 0.0);
+                    self.keys.remove(&KeyCode::KeyW);
+                    self.keys.remove(&KeyCode::KeyS);
+                    self.keys.remove(&KeyCode::KeyA);
+                    self.keys.remove(&KeyCode::KeyD);
+                    return;
+                }
+
+                // Look gesture release
+                if state.look_id == Some(touch.id) {
+                    let elapsed = state
+                        .look_start_time
+                        .map_or(0, |t| t.elapsed().as_millis());
+                    let moved = state.look_moved_dist;
+                    let was_mining = state.is_mining;
+                    // A gesture that started on the inventory button's
+                    // enlarged corner zone: a quick tap opens the inventory,
+                    // everything else (swipe, cancel) just releases.
+                    let from_inv_corner = state.inv_corner_id == Some(touch.id);
+                    // A system cancellation (edge navigation, notification
+                    // shade) must only release, never act: no interact /
+                    // place / attack from a touch the user did not finish.
+                    let cancelled = touch.phase == TouchPhase::Cancelled;
+
+                    state.look_id = None;
+                    state.is_mining = false;
+                    state.inv_corner_id = None;
+
+                    if from_inv_corner {
+                        if !cancelled && moved < 25.0 && elapsed < 250 {
+                            self.keys.insert(KeyCode::KeyE);
+                            let _ = self.key_pressed(KeyCode::KeyE);
+                            self.keys.remove(&KeyCode::KeyE);
+                            self.cursor = (sw / 2.0, sh / 2.0);
+                            // Opening the inventory ends every in-game
+                            // gesture right here: a camera finger held
+                            // across this tap must not keep mining or turn
+                            // the view with a stale delta later (the next
+                            // event would purge it too, but purge now so
+                            // even the first event after the switch is
+                            // clean).
+                            self.reset_mobile_gestures(&mut state);
+                        }
+                        return;
+                    }
+
+                    if was_mining {
+                        let _ = self.play_mouse(MouseButton::Left, false);
+                    } else if !cancelled && moved < 25.0 && elapsed < 250 {
+                        // Quick tap: interact / place block / attack
+                        if self.pick_entity_hit().is_some() {
+                            let _ = self.play_mouse(MouseButton::Left, true);
+                            let _ = self.play_mouse(MouseButton::Left, false);
+                        } else {
+                            // Place block / interact
+                            let _ = self.play_mouse(MouseButton::Right, true);
+                            let _ = self.play_mouse(MouseButton::Right, false);
+                        }
+                    }
+                    return;
+                }
+            }
+        }
+    }
+
+    /// Handles touch events in menus, titles, inventory, options, and paused screens.
+    fn handle_menu_touch(
+        &mut self,
+        touch: Touch,
+        gx: f32,
+        gy: f32,
+        sw: f32,
+        sh: f32,
+        scale: f32,
+    ) {
+        // 0. The mini side panel (when open) sits over the current screen:
+        // its taps are keys and must never leak into the field, buttons or
+        // slots underneath. Taps outside it reach the screen as usual.
+        if self.mobile_panel_touch(&touch, gx, gy, sw, sh) {
+            return;
+        }
+
+        // 1. Non-inventory screens (titles, paused, options, death, dialogs, etc.)
+        if !matches!(self.screen, Screen::Inventory | Screen::Creative) {
+            // A screen switch can leave a stale inventory gesture behind
+            // (a finger was down while the screen changed outside the
+            // gameplay flip): release its virtual buttons and drop the
+            // state, so the next inventory entry starts clean.
+            let mut state = TOUCH_STATE.lock().unwrap();
+            if state.inv_touch_id.is_some() || state.inv_lmb_id.is_some() {
+                self.reset_mobile_gestures(&mut state);
+            }
+            drop(state);
+            self.cursor = (gx, gy);
+            match touch.phase {
+                TouchPhase::Started => {
+                    // One tap = exactly one activation: a bounced second
+                    // press of the same tap (same spot within a beat) is
+                    // swallowed. The first press may already have switched
+                    // the screen under the finger, and the bounce would
+                    // otherwise click whatever sits under it there.
+                    let mut state = TOUCH_STATE.lock().unwrap();
+                    let now = Instant::now();
+                    let bounce = state.last_menu_press.is_some_and(|(t, x, y)| {
+                        now.duration_since(t).as_millis() < MENU_BOUNCE_MS
+                            && (gx - x) * (gx - x) + (gy - y) * (gy - y)
+                                <= MENU_BOUNCE_DIST * MENU_BOUNCE_DIST
+                    });
+                    state.last_menu_press = Some((now, gx, gy));
+                    drop(state);
+                    if bounce {
+                        return;
+                    }
+                    // Options screens: the press grabs what is under the
+                    // finger (button, slider, scrollbar); a press on empty
+                    // space starts a scroll drag instead (see Moved).
+                    if self.screen == Screen::Options
+                        && gy >= MENU_SAFE_TOP
+                        && gy <= sh - MENU_SAFE_BOTTOM
+                    {
+                        let hit = self.mobile_options_press();
+                        if !hit {
+                            let mut state = TOUCH_STATE.lock().unwrap();
+                            state.menu_scroll = Some((touch.id, gy));
+                        }
+                        return;
+                    }
+                    let _ = self.dispatch_menu_mouse(true, MouseButton::Left, None);
+                }
+                TouchPhase::Moved => {
+                    // An options scroll drag: the content follows the
+                    // finger 1:1 (options_scroll moves 18 px per unit).
+                    {
+                        let mut state = TOUCH_STATE.lock().unwrap();
+                        if let Some((id, last_y)) = state.menu_scroll {
+                            if touch.id == id {
+                                let dy = gy - last_y;
+                                state.menu_scroll = Some((id, gy));
+                                drop(state);
+                                self.options_scroll(dy / 18.0);
+                                return;
+                            }
+                        }
+                    }
+                    if let Some(title) = &mut self.title {
+                        title.drag(self.cursor, (sw, sh));
+                        title.drag_field(&self.gui.atlas, self.cursor.0);
+                    }
+                    if self.screen == Screen::Options {
+                        // Sliders and scrollbars follow the finger; buttons
+                        // never re-fire on movement (the old full click
+                        // here made every tap activate a second item).
+                        self.mobile_options_drag();
+                    }
+                }
+                TouchPhase::Ended | TouchPhase::Cancelled => {
+                    // Finish a scroll drag (the release also clears the
+                    // grabbed-widget state the press set).
+                    let scrolled = {
+                        let mut state = TOUCH_STATE.lock().unwrap();
+                        state.menu_scroll.take().is_some()
+                    };
+                    let _ = self.dispatch_menu_mouse(false, MouseButton::Left, None);
+                    if !scrolled && self.screen == Screen::Dead {
+                        let _ = self.death_click();
+                    }
+                    // Glow fix: clear hovered button highlight on finger release
+                    self.cursor = (-1000.0, -1000.0);
+                }
+            }
+            return;
+        }
+
+        // 2. Inventory / container screens (Screen::Inventory | Screen::Creative)
+        // Ensure cursor is initialized to center if parked offscreen — but a
+        // legitimate touch may land exactly on the pixel column/row 0, so
+        // "on the boundary" must not count as uninitialized.
+        if cursor_uninitialized(self.cursor, sw, sh) {
+            self.cursor = (sw / 2.0, sh / 2.0);
+        }
+
+        // Quick close zone (top-right corner) -> Escape. Deliberately much
+        // larger than the old 35 x 40 strip and strictly separated from the
+        // slot area: a tap just below the old strip used to fall through to
+        // the inventory slot handler and click a slot (or the panel) at the
+        // screen edge. Nothing interactive sits in this corner in either
+        // inventory screen (the panels are centred), so the whole corner is
+        // reserved for closing.
+        if gy < 60.0 && gx > sw - 60.0 && touch.phase == TouchPhase::Started {
+            // Release a held second-finger LMB before closing, so the
+            // virtual mouse button never sticks across the screen change.
+            let mut state = TOUCH_STATE.lock().unwrap();
+            let lmb_held = state.inv_lmb_id.take().is_some();
+            drop(state);
+            if lmb_held {
+                let _ = self.dispatch_menu_mouse(false, MouseButton::Left, None);
+            }
+            self.keys.insert(KeyCode::Escape);
+            let _ = self.key_pressed(KeyCode::Escape);
+            self.keys.remove(&KeyCode::Escape);
+            self.cursor = (-1000.0, -1000.0);
+            let mut state = TOUCH_STATE.lock().unwrap();
+            state.inv_touch_id = None;
+            state.inv_start_pos = (0.0, 0.0);
+            state.inv_last = (0.0, 0.0);
+            state.inv_start_time = None;
+            state.inv_pressed = false;
+            state.inv_is_right = false;
+            state.inv_moved = false;
+            return;
+        }
+
+        match touch.phase {
+            TouchPhase::Started => {
+                let mut state = TOUCH_STATE.lock().unwrap();
+                // Virtual-mouse model (reference UX): the FIRST finger moves
+                // the inventory cursor relatively and never teleports it, so
+                // the finger never covers the slot being aimed at. A SECOND
+                // finger acts as a held Left mouse button (logic-only port
+                // of the reference's on-screen LMB button): press it, sweep
+                // the cursor with the first finger — that is the stack drag
+                // (quick-craft distribute, creative scrollbar). A third
+                // finger is ignored.
+                if state.inv_touch_id.is_none() {
+                    state.inv_touch_id = Some(touch.id);
+                    state.inv_start_pos = (gx, gy);
+                    state.inv_last = (gx, gy);
+                    state.inv_start_time = Some(Instant::now());
+                    state.inv_moved = false;
+                    state.inv_pressed = false;
+                    state.inv_is_right = false;
+                    // Deliberately no `self.cursor = (gx, gy)` here: in the
+                    // relative model touching down must not teleport the
+                    // cursor (same as the reference's virtual mouse).
+                } else if state.inv_lmb_id.is_none() && state.inv_touch_id != Some(touch.id) {
+                    state.inv_lmb_id = Some(touch.id);
+                    drop(state);
+                    // Press at the current cursor position.
+                    let _ = self.dispatch_menu_mouse(true, MouseButton::Left, None);
+                }
+            }
+
+            TouchPhase::Moved => {
+                let mut state = TOUCH_STATE.lock().unwrap();
+                if state.inv_touch_id == Some(touch.id) {
+                    // Relative cursor movement: the cursor follows the
+                    // finger's delta (INV_CURSOR_SENSITIVITY GUI px per
+                    // finger GUI px), clamped to the screen.
+                    let cursor = self.cursor;
+                    self.cursor = (
+                        (cursor.0 + (gx - state.inv_last.0) * INV_CURSOR_SENSITIVITY)
+                            .clamp(0.0, (sw - 1.0).max(0.0)),
+                        (cursor.1 + (gy - state.inv_last.1) * INV_CURSOR_SENSITIVITY)
+                            .clamp(0.0, (sh - 1.0).max(0.0)),
+                    );
+                    state.inv_last = (gx, gy);
+
+                    let dx = gx - state.inv_start_pos.0;
+                    let dy = gy - state.inv_start_pos.1;
+                    // Reference drag threshold: 3 GUI px of travel marks the
+                    // gesture as a cursor move, suppressing the release tap.
+                    if !state.inv_moved && dx * dx + dy * dy > INV_DRAG_DIST_SQ {
+                        state.inv_moved = true;
+                    }
+                } else if state.inv_lmb_id != Some(touch.id) {
+                    // Neither the cursor finger nor the LMB finger.
+                    return;
+                }
+
+                let held = state.inv_pressed || state.inv_lmb_id.is_some();
+                drop(state);
+                if held {
+                    // A mouse button is held (RMB hold-drag or the
+                    // second-finger LMB): feed the moved-through slots
+                    // (quick-craft distribute), the creative scrollbar and
+                    // the loom.
+                    self.inventory_drag_move();
+                    if self.screen == Screen::Creative {
+                        let b = HudBatch::new([
+                            (sw * scale).round() as u32,
+                            (sh * scale).round() as u32,
+                        ]);
+                        let (_, oy) = Self::creative_origin(&b);
+                        self.creative_screen.drag_scrollbar(self.cursor.1 - oy);
+                    }
+                    if self.screen == Screen::Inventory {
+                        self.loom_drag();
+                    }
+                }
+            }
+
+            TouchPhase::Ended | TouchPhase::Cancelled => {
+                let mut state = TOUCH_STATE.lock().unwrap();
+                if state.inv_lmb_id == Some(touch.id) {
+                    // The LMB finger releases: release the held button.
+                    state.inv_lmb_id = None;
+                    drop(state);
+                    let _ = self.dispatch_menu_mouse(false, MouseButton::Left, None);
+                    return;
+                }
+                if state.inv_touch_id == Some(touch.id) {
+                    let pressed = state.inv_pressed;
+                    let is_right = state.inv_is_right;
+                    let moved = state.inv_moved;
+                    let elapsed = state.inv_start_time.map_or(0, |t| t.elapsed().as_millis());
+
+                    state.inv_touch_id = None;
+                    state.inv_start_pos = (0.0, 0.0);
+                    state.inv_last = (0.0, 0.0);
+                    state.inv_start_time = None;
+                    state.inv_pressed = false;
+                    state.inv_is_right = false;
+                    state.inv_moved = false;
+                    drop(state);
+
+                    if !pressed {
+                        // Quick Tap (<500ms, unmoved): Vanilla Left Click at
+                        // the CURSOR position (not the finger position).
+                        // - If empty hand: picks up entire stack
+                        // - If holding stack: places entire stack / swaps
+                        // A moved or cancelled touch only releases: it never
+                        // counts as a tap (no accidental stack pickup).
+                        if touch.phase == TouchPhase::Ended && !moved && elapsed < 500 {
+                            let _ = self.dispatch_menu_mouse(true, MouseButton::Left, None);
+                            let _ = self.dispatch_menu_mouse(false, MouseButton::Left, None);
+                        }
+                    } else {
+                        // Release active RMB hold (click or sweep).
+                        let button = if is_right {
+                            MouseButton::Right
+                        } else {
+                            MouseButton::Left
+                        };
+                        let _ = self.dispatch_menu_mouse(false, button, None);
+                    }
+
+                    // In inventory, NEVER reset cursor to (-1000, -1000)!
+                    // The cursor keeps its position: in the relative model
+                    // it is the virtual mouse pointer, and the carried item
+                    // renders under it.
+                }
+            }
+        }
+    }
+
+    /// Ticked once per frame / engine tick to update hold gestures (continuous mining & inventory RMB hold).
+    pub(crate) fn tick_mobile(&mut self) {
+        let (sw, sh) = if let Some(r) = &self.renderer {
+            let b = HudBatch::new([r.config.width, r.config.height]);
+            (b.width, b.height)
+        } else {
+            (854.0, 480.0)
+        };
+
+        // Ensure cursor is centered when in inventory if parked offscreen
+        // (not merely on the boundary: a touch at pixel (0, y) is valid).
+        if matches!(self.screen, Screen::Inventory | Screen::Creative) {
+            if cursor_uninitialized(self.cursor, sw, sh) {
+                self.cursor = (sw / 2.0, sh / 2.0);
+            }
+        } else if self.screen == Screen::Playing && self.cursor.0 >= 0.0 {
+            self.cursor = (-1000.0, -1000.0);
+        }
+
+        let Ok(mut state) = TOUCH_STATE.try_lock() else {
+            return;
+        };
+
+        // Screen changed without any touch traffic in between (death
+        // screen, keyboard-driven menus, ...): drop the gestures of the
+        // previous screen, exactly like handle_mobile_touch does.
+        let gameplay = self.screen == Screen::Playing
+            && self.title.is_none()
+            && !self.is_overlay_open();
+        if state.was_gameplay != gameplay {
+            state.was_gameplay = gameplay;
+            self.reset_mobile_gestures(&mut state);
+        }
+
+        // The keyboard follows the focused text field even without touch
+        // traffic (chat opened from the HUD button, sign editor, ...).
+        self.sync_mobile_keyboard(&mut state);
+
+        // 1. In-game continuous mining (>250ms hold). A look gesture that
+        // started on the inventory button's corner zone never mines: holding
+        // near the button must not attack whatever the crosshair points at.
+        if self.screen == Screen::Playing
+            && state.look_id.is_some()
+            && state.inv_corner_id.is_none()
+            && !state.is_mining
+            && state
+                .look_start_time
+                .is_some_and(|t| t.elapsed() >= std::time::Duration::from_millis(250))
+        {
+            state.is_mining = true;
+            let _ = self.play_mouse(MouseButton::Left, true);
+        }
+
+        // 2. Inventory hold (>=500ms stationary hold) -> Right Click (RMB),
+        // fires before release (reference UX):
+        // - If hand empty: takes half stack
+        // - If hand carrying stack: places 1 item into slot, and initiates
+        //   the RMB distribute sweep (deposit 1 per traversed slot)
+        if matches!(self.screen, Screen::Inventory | Screen::Creative)
+            && state.inv_touch_id.is_some()
+            && !state.inv_moved
+            && !state.inv_pressed
+            && state
+                .inv_start_time
+                .is_some_and(|t| t.elapsed().as_millis() >= INV_HOLD_RIGHT_MS)
+        {
+            state.inv_pressed = true;
+            state.inv_is_right = true;
+            drop(state);
+            let _ = self.dispatch_menu_mouse(true, MouseButton::Right, None);
+        }
+    }
+
+    /// Renders minimal on-screen touch controls: the mini side keyboard
+    /// panel (when toggled), round movement joystick, jump button, chat
+    /// button, keyboard edge button, inventory button.
+    pub(crate) fn draw_mobile_hud(&self, batch: &mut HudBatch) {
+        let atlas = &self.gui.atlas;
+        let Ok(state) = TOUCH_STATE.try_lock() else {
+            return;
+        };
+
+        // 0. Mini side keyboard panel, whenever the player toggled it on.
+        if state.osk_open {
+            self.draw_mobile_panel(batch, atlas, &state);
+        }
+
+        if self.screen != Screen::Playing
+            || self.title.is_some()
+            || self.is_overlay_open()
+        {
+            return;
+        }
+
+        let sw = batch.width;
+        let sh = batch.height;
+
+        // Panel edge button (right edge, vertically centred at sh * 0.4).
+        // Only while the panel is closed: when it is open, its spot is a
+        // panel key and the panel closes through its own "x" tab.
+        if !state.osk_open {
+            let pb_center = (sw - 14.0, sh * 0.4);
+            draw_circle_fan(atlas, batch, pb_center.0, pb_center.1, 15.0, rgba(255, 255, 255, 45));
+            draw_circle_ring(
+                atlas,
+                batch,
+                pb_center.0,
+                pb_center.1,
+                13.5,
+                15.0,
+                rgba(255, 255, 255, 100),
+            );
+            let pb_text = "KBD";
+            let pbtw = HudBatch::text_width(atlas, pb_text);
+            batch.text(
+                atlas,
+                pb_text,
+                pb_center.0 - pbtw / 2.0,
+                pb_center.1 - 4.0,
+                rgba(255, 255, 255, 230),
+                false,
+            );
+        }
+
+        // 1. Round movement joystick (bottom-left)
+        let stick_center = if state.stick_id.is_some() {
+            state.stick_origin
+        } else {
+            (60.0, sh - 60.0)
+        };
+        // Base outer ring & translucent fill
+        draw_circle_fan(atlas, batch, stick_center.0, stick_center.1, 40.0, rgba(255, 255, 255, 30));
+        draw_circle_ring(
+            atlas,
+            batch,
+            stick_center.0,
+            stick_center.1,
+            38.5,
+            40.0,
+            rgba(255, 255, 255, 75),
+        );
+
+        // Knob
+        let knob_pos = (
+            stick_center.0 + state.stick_offset.0,
+            stick_center.1 + state.stick_offset.1,
+        );
+        draw_circle_fan(atlas, batch, knob_pos.0, knob_pos.1, 18.0, rgba(255, 255, 255, 110));
+        draw_circle_ring(
+            atlas,
+            batch,
+            knob_pos.0,
+            knob_pos.1,
+            16.5,
+            18.0,
+            rgba(255, 255, 255, 200),
+        );
+
+        // 2. Jump button (bottom-right: center at sw - 48.0, sh - 48.0)
+        let jump_center = (sw - 48.0, sh - 48.0);
+        let jump_pressed = state.jump_id.is_some();
+        let jump_fill = if jump_pressed {
+            rgba(255, 255, 255, 130)
+        } else {
+            rgba(255, 255, 255, 45)
+        };
+        draw_circle_fan(atlas, batch, jump_center.0, jump_center.1, 26.0, jump_fill);
+        draw_circle_ring(
+            atlas,
+            batch,
+            jump_center.0,
+            jump_center.1,
+            24.5,
+            26.0,
+            rgba(255, 255, 255, 100),
+        );
+        let jump_text = "JUMP";
+        let tw = HudBatch::text_width(atlas, jump_text);
+        batch.text(
+            atlas,
+            jump_text,
+            jump_center.0 - tw / 2.0,
+            jump_center.1 - 4.0,
+            rgba(255, 255, 255, 230),
+            false,
+        );
+
+        // 3. Inventory button (top-right: center at sw - 30.0, 26.0)
+        let inv_center = (sw - 30.0, 26.0);
+        draw_circle_fan(atlas, batch, inv_center.0, inv_center.1, 18.0, rgba(255, 255, 255, 45));
+        draw_circle_ring(
+            atlas,
+            batch,
+            inv_center.0,
+            inv_center.1,
+            16.5,
+            18.0,
+            rgba(255, 255, 255, 100),
+        );
+        let inv_text = "INV";
+        let itw = HudBatch::text_width(atlas, inv_text);
+        batch.text(
+            atlas,
+            inv_text,
+            inv_center.0 - itw / 2.0,
+            inv_center.1 - 4.0,
+            rgba(255, 255, 255, 230),
+            false,
+        );
+
+        // 4. Chat button (top-right under INV: center at sw - 30.0, 82.0).
+        // Opens the chat; the system keyboard (IME) is raised over it.
+        let kb_center = (sw - 30.0, 82.0);
+        draw_circle_fan(atlas, batch, kb_center.0, kb_center.1, 18.0, rgba(255, 255, 255, 45));
+        draw_circle_ring(
+            atlas,
+            batch,
+            kb_center.0,
+            kb_center.1,
+            16.5,
+            18.0,
+            rgba(255, 255, 255, 100),
