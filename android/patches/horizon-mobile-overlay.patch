+/// The mini panel's tabs: F (special keys), letters, digits/symbols.
+#[derive(Clone, Copy, PartialEq, Default)]
+pub(crate) enum OskTab {
+    #[default]
+    Func,
+    Letters,
+    Digits,
+}
+
+/// A sticky modifier toggled from the panel's F tab (lit state lives in
+/// `Game::keys`, so real key handlers see it; cleared with the panel).
+#[derive(Clone, Copy, PartialEq)]
+pub(crate) enum OskMod {
+    Ctrl,
+    Alt,
+}
+
+/// One key of the mini side keyboard.
+#[derive(Clone, Copy, PartialEq)]
+enum OskKey {
+    Char(char),
+    Shift,
+    Space,
+    Backspace,
+    Enter,
+    Esc,
+    Tab,
+    /// A special key sent as its key code: F1–F12, Delete, Home, End and
+    /// the arrows.
+    Func(KeyCode),
+    Mod(OskMod),
+}
+
+impl OskKey {
+    fn label(&self, shift: bool) -> String {
+        match self {
+            OskKey::Char(ch) => {
+                if shift {
+                    ch.to_ascii_uppercase().to_string()
+                } else {
+                    ch.to_string()
+                }
+            }
+            OskKey::Shift => "shf".into(),
+            OskKey::Space => "space".into(),
+            OskKey::Backspace => "del".into(),
+            OskKey::Enter => "ent".into(),
+            OskKey::Esc => "esc".into(),
+            OskKey::Tab => "tab".into(),
+            OskKey::Func(KeyCode::F1) => "F1".into(),
+            OskKey::Func(KeyCode::F2) => "F2".into(),
+            OskKey::Func(KeyCode::F3) => "F3".into(),
+            OskKey::Func(KeyCode::F4) => "F4".into(),
+            OskKey::Func(KeyCode::F5) => "F5".into(),
+            OskKey::Func(KeyCode::F6) => "F6".into(),
+            OskKey::Func(KeyCode::F7) => "F7".into(),
+            OskKey::Func(KeyCode::F8) => "F8".into(),
+            OskKey::Func(KeyCode::F9) => "F9".into(),
+            OskKey::Func(KeyCode::F10) => "F10".into(),
+            OskKey::Func(KeyCode::F11) => "F11".into(),
+            OskKey::Func(KeyCode::F12) => "F12".into(),
+            OskKey::Func(KeyCode::Delete) => "del".into(),
+            OskKey::Func(KeyCode::Home) => "hm".into(),
+            OskKey::Func(KeyCode::End) => "end".into(),
+            OskKey::Func(KeyCode::ArrowUp) => "up".into(),
+            OskKey::Func(KeyCode::ArrowDown) => "dn".into(),
+            OskKey::Func(KeyCode::ArrowLeft) => "<".into(),
+            OskKey::Func(KeyCode::ArrowRight) => ">".into(),
+            OskKey::Func(_) => String::new(),
+            OskKey::Mod(OskMod::Ctrl) => "ctrl".into(),
+            OskKey::Mod(OskMod::Alt) => "alt".into(),
+        }
+    }
+}
+
+/// What a keyboard tap feeds into the engine. `flush_mobile_keyboard`
+/// routes each output to the focused text field through the same handlers
+/// a physical keystroke reaches (see `Game::mobile_keyboard_output`).
+pub(crate) enum OskOut {
+    Text(String),
+    Backspace,
+    Enter,
+    /// A special key: F1–F12, Esc, Tab, arrows, Delete, Home, End.
+    Key(KeyCode),
+    /// Toggle a sticky modifier (Ctrl/Alt) in the engine's key state.
+    Mod(OskMod),
+}
+
+/// A row of keys and their widths in key units (a full row is 6 units:
+/// the panel is a compact 6-key-wide strip docked to the right edge).
+type OskRow = &'static [(OskKey, f32)];
+
+const fn k(ch: char) -> (OskKey, f32) {
+    (OskKey::Char(ch), 1.0)
+}
+const fn fk(code: KeyCode) -> (OskKey, f32) {
+    (OskKey::Func(code), 1.0)
+}
+
+/// F tab: the PC's special keys — F1–F12, Esc, Tab, sticky Ctrl/Alt,
+/// Delete, Enter, the arrows, Home/End. Available straight in gameplay
+/// (F1 HUD, F3 debug, F5 view, F11 fullscreen, ...) and over any screen.
+const FUNC: [OskRow; 4] = [
+    &[
+        fk(KeyCode::F1),
+        fk(KeyCode::F2),
+        fk(KeyCode::F3),
+        fk(KeyCode::F4),
+        fk(KeyCode::F5),
+        fk(KeyCode::F6),
+    ],
+    &[
+        fk(KeyCode::F7),
+        fk(KeyCode::F8),
+        fk(KeyCode::F9),
+        fk(KeyCode::F10),
+        fk(KeyCode::F11),
+        fk(KeyCode::F12),
+    ],
+    &[
+        (OskKey::Esc, 1.0),
+        (OskKey::Tab, 1.0),
+        (OskKey::Mod(OskMod::Ctrl), 1.0),
+        (OskKey::Mod(OskMod::Alt), 1.0),
+        fk(KeyCode::Delete),
+        (OskKey::Enter, 1.0),
+    ],
+    &[
+        fk(KeyCode::ArrowUp),
+        fk(KeyCode::ArrowDown),
+        fk(KeyCode::ArrowLeft),
+        fk(KeyCode::ArrowRight),
+        fk(KeyCode::Home),
+        fk(KeyCode::End),
+    ],
+];
+
+/// abc tab: QWERTY for names, chat and commands (with one-shot Shift and
+/// a space bar). Taps reach the focused field like typed keys.
+const LETTERS: [OskRow; 6] = [
+    &[k('q'), k('w'), k('e'), k('r'), k('t'), k('y')],
+    &[k('u'), k('i'), k('o'), k('p'), k('a'), k('s')],
+    &[k('d'), k('f'), k('g'), k('h'), k('j'), k('k')],
+    &[k('l'), k('z'), k('x'), k('c'), k('v'), k('b')],
+    &[k('n'), k('m'), k(','), k('.'), k('-'), k('/')],
+    &[
+        (OskKey::Shift, 1.2),
+        (OskKey::Space, 2.8),
+        (OskKey::Backspace, 1.0),
+        (OskKey::Enter, 1.0),
+    ],
+];
+
+/// 123 tab: digits and the full PC punctuation/symbol set.
+const DIGITS: [OskRow; 7] = [
+    &[k('1'), k('2'), k('3'), k('4'), k('5'), k('6')],
+    &[k('7'), k('8'), k('9'), k('0'), k('-'), k('_')],
+    &[k('='), k('+'), k('['), k(']'), k('{'), k('}')],
+    &[k('\\'), k('|'), k(';'), k(':'), k('\''), k('"')],
+    &[k('`'), k('~'), k('!'), k('@'), k('#'), k('$')],
+    &[k('%'), k('^'), k('&'), k('*'), k('('), k(')')],
+    &[k(','), k('.'), k('/'), k('<'), k('>'), k('?')],
+];
+
+/// Geometry of the mini panel for one frame. The key unit scales with the
+/// actual GUI width (capped, so tablets don't grow giant keys) and the
+/// panel docks to the right screen edge, vertically centred.
+struct PanelLayout {
+    x0: f32,
+    y0: f32,
+    width: f32,
+    height: f32,
+    unit: f32,
+    gap: f32,
+    key_h: f32,
+    tabs_h: f32,
+    pad: f32,
+}
+
+fn panel_layout(sw: f32, sh: f32) -> PanelLayout {
+    let gap = 3.0;
+    let pad = 5.0;
+    let unit = ((sw * 0.26) / 6.0).clamp(22.0, 34.0);
+    let key_h = (unit * 0.9).clamp(22.0, 32.0);
+    let tabs_h = 20.0;
+    let width = 6.0 * unit + 5.0 * gap + 2.0 * pad;
+    // Tall enough for the 123 tab's 7 rows; other tabs just use the top.
+    let height = 2.0 * pad + tabs_h + gap + 7.0 * (key_h + gap) - gap;
+    PanelLayout {
+        x0: sw - width,
+        y0: (sh - height) / 2.0,
+        width,
+        height,
+        unit,
+        gap,
+        key_h,
+        tabs_h,
+        pad,
+    }
+}
+
+/// The key under a GUI-space point on the given tab, if it lands on one
+/// (gaps between keys hit nothing, but stay consumed by the panel).
+fn panel_key_at(layout: &PanelLayout, tab: OskTab, gx: f32, gy: f32) -> Option<OskKey> {
+    let rows: &[OskRow] = match tab {
+        OskTab::Func => &FUNC,
+        OskTab::Letters => &LETTERS,
+        OskTab::Digits => &DIGITS,
+    };
+    let keys_y = layout.y0 + layout.pad + layout.tabs_h + layout.gap;
+    let rel_y = gy - keys_y;
+    if rel_y < 0.0 {
+        return None;
+    }
+    let r = ((rel_y / (layout.key_h + layout.gap)).floor() as usize).min(rows.len() - 1);
+    let row = rows[r];
+    let mut left = 0.0;
+    for (key, units) in row.iter() {
+        let x = layout.x0 + layout.pad + left * (layout.unit + layout.gap);
+        let w = units * layout.unit + (units - 1.0) * layout.gap;
+        if gx >= x && gx < x + w {
+            let in_key = rel_y - r as f32 * (layout.key_h + layout.gap) <= layout.key_h;
+            return in_key.then_some(*key);
+        }
+        left += units;
+    }
+    None
+}
+
+/// Applies a pressed key to the panel state: queues its output and updates
+/// the one-shot shift.
+fn osk_press_key(state: &mut MobileTouchState, key: OskKey) {
+    match key {
+        OskKey::Char(ch) => {
+            let ch = if state.osk_shift {
+                ch.to_ascii_uppercase()
+            } else {
+                ch
+            };
+            if ch.is_ascii_alphabetic() {
+                state.osk_shift = false;
+            }
+            state.osk_queue.push(OskOut::Text(ch.to_string()));
+        }
+        OskKey::Shift => state.osk_shift = !state.osk_shift,
+        OskKey::Space => state.osk_queue.push(OskOut::Text(" ".into())),
+        OskKey::Backspace => state.osk_queue.push(OskOut::Backspace),
+        OskKey::Enter => state.osk_queue.push(OskOut::Enter),
+        OskKey::Esc => state.osk_queue.push(OskOut::Key(KeyCode::Escape)),
+        OskKey::Tab => state.osk_queue.push(OskOut::Key(KeyCode::Tab)),
+        OskKey::Func(code) => state.osk_queue.push(OskOut::Key(code)),
+        OskKey::Mod(m) => state.osk_queue.push(OskOut::Mod(m)),
+    }
+}
diff --git a/crates/horizon-client/src/official_install.rs b/crates/horizon-client/src/official_install.rs
new file mode 100644
index 0000000..4d193c3
--- /dev/null
+++ b/crates/horizon-client/src/official_install.rs
@@ -0,0 +1,561 @@
+#![cfg(target_os = "android")]
+//! On-device installation of the official Minecraft resources from Mojang's
+//! HTTPS endpoints, triggered on demand by the launcher through a flag file
+//! (the desktop launcher's "Download" button, mobile edition).
+//!
+//! Flow (never automatic — the user decides, the launcher shows progress):
+//! 1. The launcher writes `<home>/install-assets.flag` (content: the desired
+//!    Horizon resources version, empty = the supported one) and starts the
+//!    game process.
+//! 2. `android_main` sees the flag BEFORE the engine looks for resources and
+//!    calls [`install`]: the engine tables bundled in the APK
+//!    (`assets/engine-data.zip`, or a launcher-supplied
+//!    `<home>/engine-data-<version>.zip`) are merged with the vanilla client
+//!    jar, its `data/` datapack and the asset-index objects (textures and
+//!    sounds) downloaded from `piston-meta.mojang.com`,
+//!    `piston-data.mojang.com` and `resources.download.minecraft.net` — the
+//!    same official endpoints the desktop launcher uses.
+//! 3. Progress is published to `<home>/install-progress.txt` for the
+//!    launcher, plus the regular log.
+//! 4. After the attempt (success or failure) the process exits without
+//!    entering the game; the launcher reads the result and relaunches.
+//!
+//! Nothing is hosted or redistributed: files are downloaded from Mojang to
+//! the user's device, verified by SHA-1, and combined with the engine's own
+//! generated tables. Every URL is restricted to the official Mojang hosts.
+
+use crate::Result;
+use sha1::{Digest, Sha1};
+use std::{
+    fs,
+    io::{Read, Write},
+    path::{Component, Path, PathBuf},
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicU64, AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+/// The launcher's download button: presence of this file in the game home
+/// directory requests an installation run.
+pub const FLAG_FILE: &str = "install-assets.flag";
+/// Machine-readable progress for the launcher: `stage done total` per line
+/// (atomically replaced), `done 1 1` on success, `error <message>` on failure.
+pub const PROGRESS_FILE: &str = "install-progress.txt";
+/// APK-bundled engine tables (horizon-prepare output: generated JSON/NBT
+/// tables, `worldgen/`, `biome-parameters/`; no vanilla assets).
+const ENGINE_DATA_ASSET: &str = "engine-data.zip";
+
+const CATALOG: &str = "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json";
+/// Pinned Minecraft version metadata (`research-lock.json`), embedded so the
+/// installed resources always match what this engine build implements.
+const LOCK: &str = include_str!("../../../research-lock.json");
+
+static INSTALLATION: Mutex<()> = Mutex::new(());
+
+/// Whether the engine's regular resource lookup would find a usable
+/// `files/resources` installation.
+pub fn resources_ready(home: &Path) -> bool {
+    home.join("resources")
+        .join("horizon-resources.json")
+        .is_file()
+}
+
+/// Whether the launcher requested an installation run.
+pub fn install_requested(home: &Path) -> bool {
+    home.join(FLAG_FILE).is_file()
+}
+
+fn pins() -> Result<serde_json::Value> {
+    Ok(serde_json::from_str::<serde_json::Value>(LOCK)?["minecraft"]
+        .clone())
+}
+
+fn official_url(text: &str) -> Result<()> {
+    let url = url::Url::parse(text)?;
+    if url.scheme() != "https"
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.port().is_some_and(|p| p != 443)
+        || !matches!(
+            url.host_str(),
+            Some(
+                "piston-meta.mojang.com"
+                    | "piston-data.mojang.com"
+                    | "resources.download.minecraft.net"
+                    | "launchermeta.mojang.com"
+                    | "launcher.mojang.com"
+            )
+        )
+    {
+        return Err("Download URL is not an official Mojang HTTPS endpoint".into());
+    }
+    Ok(())
+}
+
+fn agent() -> ureq::Agent {
+    // Thousands of sound objects share a host; retain pooled TLS connections.
+    static AGENT: OnceLock<ureq::Agent> = OnceLock::new();
+    AGENT
+        .get_or_init(|| {
+            ureq::AgentBuilder::new()
+                .redirects(0)
+                .timeout_connect(Duration::from_secs(30))
+                .timeout_read(Duration::from_secs(120))
+                .build()
+        })
+        .clone()
+}
+
+fn json(url: &str) -> Result<serde_json::Value> {
+    official_url(url)?;
+    let mut bytes = Vec::new();
+    agent()
+        .get(url)
+        .call()?
+        .into_reader()
+        .take(32 * 1024 * 1024)
+        .read_to_end(&mut bytes)?;
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+fn hash(path: &Path) -> Result<String> {
+    let mut file = fs::File::open(path)?;
+    let mut digest = Sha1::new();
+    let mut buffer = [0; 65536];
+    loop {
+        let n = file.read(&mut buffer)?;
+        if n == 0 {
+            break;
+        }
+        digest.update(&buffer[..n]);
+    }
+    Ok(format!("{:x}", digest.finalize()))
+}
+
+struct Download {
+    url: String,
+    sha1: String,
+    size: u64,
+    path: PathBuf,
+}
+
+impl Download {
+    fn from(value: &serde_json::Value, path: PathBuf) -> Result<Self> {
+        let file = Self {
+            url: value["url"].as_str().ok_or("Missing download URL")?.into(),
+            sha1: value["sha1"].as_str().ok_or("Missing download hash")?.into(),
+            size: value["size"].as_u64().ok_or("Missing download size")?,
+            path,
+        };
+        official_url(&file.url)?;
+        if file.sha1.len() != 40
+            || !file.sha1.bytes().all(|c| c.is_ascii_hexdigit())
+            || file.size > 1024 * 1024 * 1024
+        {
+            return Err("Invalid Mojang download metadata".into());
+        }
+        Ok(file)
+    }
+
+    /// Downloads (or reuses) the file, verifying size and SHA-1. Retries
+    /// three times; a failed attempt leaves the partial file removed so the
+    /// next run starts clean.
+    fn get(&self) -> Result<()> {
+        if self.path.is_file()
+            && fs::metadata(&self.path)?.len() == self.size
+            && hash(&self.path)? == self.sha1
+        {
+            return Ok(());
+        }
+        fs::create_dir_all(self.path.parent().ok_or("Missing download directory")?)?;
+        let partial = self.path.with_extension("partial");
+        for attempt in 0..3 {
+            let result = (|| -> Result<()> {
+                let mut input = agent()
+                    .get(&self.url)
+                    .call()?
+                    .into_reader()
+                    .take(self.size + 1);
+                let mut output = fs::File::create(&partial)?;
+                let count = std::io::copy(&mut input, &mut output)?;
+                output.flush()?;
+                drop(output);
+                if count != self.size || hash(&partial)? != self.sha1 {
+                    return Err("Mojang file checksum or size mismatch".into());
+                }
+                fs::rename(&partial, &self.path)?;
+                Ok(())
+            })();
+            if result.is_ok() {
+                return result;
+            }
+            let _ = fs::remove_file(&partial);
+            if attempt == 2 {
+                return result;
+            }
+            std::thread::sleep(Duration::from_millis(500 * (attempt + 1)));
+        }
+        unreachable!()
+    }
+}
+
+/// Asset object names are relative paths under `assets/` inside the
+/// resources root; reject anything that could escape it.
+fn relative(name: &str) -> Result<&Path> {
+    let path = Path::new(name);
+    if path
+        .components()
+        .any(|c| !matches!(c, Component::Normal(_)))
+        || name.contains('\\')
+    {
+        return Err("Unsafe asset path".into());
+    }
+    Ok(path)
+}
+
+/// Launcher-facing progress: atomically rewrite `install-progress.txt`
+/// (`stage done total`, or `error <message>`), throttled so thousands of
+/// small file updates do not hammer the storage.
+struct Progress {
+    path: PathBuf,
+    stage: String,
+    done: u64,
+    total: u64,
+    written: Instant,
+}
+
+impl Progress {
+    fn new(home: &Path) -> Self {
+        Self {
+            path: home.join(PROGRESS_FILE),
+            stage: "preparing".into(),
+            done: 0,
+            total: 0,
+            written: Instant::now() - Duration::from_secs(1),
+        }
+    }
+
+    fn report(&mut self, stage: &str, done: u64, total: u64) {
+        self.stage = stage.into();
+        self.done = done;
+        self.total = total;
+        self.flush();
+    }
+
+    /// Download progress hot path: only rewrite every 500 ms (or on stage
+    /// change), always in whole-line atomically replaced writes.
+    fn download(&mut self, done: u64, total: u64) {
+        self.done = done;
+        self.total = total;
+        if self.written.elapsed() >= Duration::from_millis(500) {
+            self.flush();
+        }
+    }
+
+    fn flush(&mut self) {
+        self.written = Instant::now();
+        let percent = if self.total > 0 {
+            self.done * 100 / self.total
+        } else {
+            0
+        };
+        let text = format!("{} {} {}\n", self.stage, percent, self.total);
+        let partial = self.path.with_extension("partial");
+        if fs::write(&partial, text.as_bytes())
+            .and_then(|()| fs::rename(&partial, &self.path))
+            .is_err()
+        {
+            // The launcher tolerates a missing progress file; never fail the
+            // installation because of progress reporting.
+        }
+    }
+}
+
+fn extract_zip_into<R: Read + std::io::Seek>(
+    archive: R,
+    destination: &Path,
+    root_prefixes: &[&str],
+) -> Result<()> {
+    let mut zip = zip::ZipArchive::new(archive)?;
+    for i in 0..zip.len() {
+        let mut entry = zip.by_index(i)?;
+        if entry.is_dir() {
+            continue;
+        }
+        let Some(name) = entry.enclosed_name() else {
+            return Err("Unsafe path in resource archive".into());
+        };
+        if entry.is_symlink() {
+            return Err("Symlink in resource archive".into());
+        }
+        if !root_prefixes.is_empty()
+            && !root_prefixes
+                .iter()
+                .any(|prefix| name.starts_with(prefix))
+        {
+            continue;
+        }
+        let path = destination.join(name);
+        fs::create_dir_all(path.parent().ok_or("Missing resource parent")?)?;
+        std::io::copy(&mut entry, &mut fs::File::create(path)?)?;
+    }
+    Ok(())
+}
+
+/// Runs the installation requested by the flag file. Returns the error on
+/// failure (also written to the progress file); the caller exits afterwards.
+pub fn install(home: &Path, app: &android_activity::AndroidApp) -> Result<()> {
+    let _guard = INSTALLATION.lock().unwrap_or_else(|e| e.into_inner());
+    let mut progress = Progress::new(home);
+    let result = install_inner(home, app, &mut progress);
+    match &result {
+        Ok(()) => progress.report("done", 1, 1),
+        Err(error) => {
+            log::error!("Official resources installation failed: {error}");
+            progress.report(&format!("error {}", error), 0, 0);
+        }
+    }
+    // The flag is consumed either way: the launcher decides on a retry.
+    let _ = fs::remove_file(home.join(FLAG_FILE));
+    result
+}
+
+fn install_inner(
+    home: &Path,
+    app: &android_activity::AndroidApp,
+    progress: &mut Progress,
+) -> Result<()> {
+    let pins = pins()?;
+    let version = pins["version"]
+        .as_str()
+        .ok_or("Missing pinned Minecraft version")?
+        .to_string();
+
+    // The flag's content selects the Horizon resources version; only the
+    // version this engine implements can be installed.
+    let requested = fs::read_to_string(home.join(FLAG_FILE))
+        .unwrap_or_default()
+        .trim()
+        .to_string();
+    if !requested.is_empty()
+        && requested != "latest"
+        && requested != horizon_core::VANILLA_VERSION
+    {
+        return Err(format!(
+            "This engine implements Horizon resources for Minecraft {version} only (requested: {requested})"
+        )
+        .into());
+    }
+
+    progress.report("metadata", 0, 0);
+    let cache = home.join(".local/downloads").join(&version);
+    fs::create_dir_all(&cache)?;
+
+    // Engine tables: prefer a launcher-supplied bundle, else the APK asset.
+    let staged_tables = cache.join("engine-data.zip");
+    let launcher_bundle = home.join(format!("engine-data-{version}.zip"));
+    if launcher_bundle.is_file() {
+        fs::copy(&launcher_bundle, &staged_tables)?;
+    } else {
+        let manager = app.asset_manager();
+        let name = std::ffi::CString::new(ENGINE_DATA_ASSET)?;
+        let Some(asset) = manager.open(&name) else {
+            return Err(format!("APK has no {ENGINE_DATA_ASSET} engine tables").into());
+        };
+        let mut output = fs::File::create(&staged_tables)?;
+        std::io::copy(&mut asset.take(512 * 1024 * 1024), &mut output)?;
+        output.flush()?;
+        drop(output);
+    }
+
+    // Version metadata from Mojang. Mojang may republish version JSONs while
+    // the game jars stay identical, so the manifest SHA-1 is checked against
+    // the pins but only warns on a mismatch; the hard engine-compatibility
+    // guarantee is the pinned client jar hash below.
+    let catalog = json(CATALOG)?;
+    let entry = catalog["versions"]
+        .as_array()
+        .and_then(|vs| vs.iter().find(|v| v["id"] == version.as_str()))
+        .ok_or("Pinned Minecraft version is not listed by Mojang")?;
+    let manifest_url = entry["url"].as_str().ok_or("Missing version metadata URL")?;
+    official_url(manifest_url)?;
+    let mut bytes = Vec::new();
+    agent()
+        .get(manifest_url)
+        .call()?
+        .into_reader()
+        .take(32 * 1024 * 1024)
+        .read_to_end(&mut bytes)?;
+    let manifest: serde_json::Value = serde_json::from_slice(&bytes)?;
+    let manifest_sha1 = format!("{:x}", Sha1::digest(&bytes));
+    let accepted = ["manifest_sha1"]
+        .into_iter()
+        .chain(
+            pins["accepted_manifest_sha1"]
+                .as_array()
+                .map(|a| a.iter().filter_map(|v| v.as_str()))
+                .into_iter()
+                .flatten(),
+        )
+        .collect::<Vec<_>>();
+    if !accepted.contains(&manifest_sha1.as_str()) {
+        log::warn!(
+            "Minecraft {version}: republished version metadata ({manifest_sha1}); game files must still match the pins"
+        );
+    }
+
+    // The client jar is the hard pin: this engine implements exactly it.
+    let client = Download::from(&manifest["downloads"]["client"], cache.join("client.jar"))?;
+    let pinned_client = pins["client_sha1"].as_str().ok_or("Missing client pin")?;
+    if client.sha1 != pinned_client {
+        return Err("Minecraft client jar differs from this engine's pinned version".into());
+    }
+    client.get()?;
+
+    // The asset index lists every vanilla asset object (textures, sounds,
+    // translations) with per-file SHA-1s. Mojang republishes it freely; the
+    // objects themselves are all individually verified on download.
+    let index = Download::from(&manifest["assetIndex"], cache.join("asset-index.json"))?;
+    index.get()?;
+    let index: serde_json::Value = serde_json::from_reader(fs::File::open(&index.path)?)?;
+    let objects = index["objects"]
+        .as_object()
+        .ok_or("Missing asset objects")?;
+
+    let mut files = Vec::new();
+    let mut assets = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    for (name, object) in objects {
+        relative(name)?;
+        let checksum = object["hash"].as_str().ok_or("Missing asset hash")?;
+        if checksum.len() != 40 || !checksum.bytes().all(|c| c.is_ascii_hexdigit()) {
+            return Err("Invalid asset hash".into());
+        }
+        let path = cache.join("objects").join(checksum);
+        assets.push((name, path.clone()));
+        if seen.insert(checksum) {
+            files.push(Download::from(
+                &serde_json::json!({
+                    "url": format!("https://resources.download.minecraft.net/{}/{checksum}", &checksum[..2]),
+                    "sha1": checksum,
+                    "size": object["size"],
+                }),
+                path,
+            )?);
+        }
+    }
+
+    let total: u64 = files.iter().map(|f| f.size).sum();
+    log::info!(
+        "Minecraft {version}: downloading {} files from Mojang ({} MiB) into {}",
+        files.len(),
+        total / 1048576,
+        cache.display()
+    );
+    progress.report("download", 0, total);
+    let next = AtomicUsize::new(0);
+    let error: Mutex<Option<String>> = Mutex::new(None);
+    // Download workers cannot share the &mut Progress: they push their byte
+    // counts into a shared counter and the scoped main thread publishes
+    // throttled progress while polling for completion.
+    let tick = AtomicU64::new(0);
+    std::thread::scope(|scope| -> Result<()> {
+        for _ in 0..8 {
+            scope.spawn(|| {
+                loop {
+                    if error.lock().unwrap().is_some() {
+                        break;
+                    }
+                    let i = next.fetch_add(1, Ordering::Relaxed);
+                    let Some(file) = files.get(i) else { break };
+                    if let Err(e) = file.get() {
+                        *error.lock().unwrap() = Some(e.to_string());
+                        break;
+                    }
+                    let _ = tick.fetch_add(file.size, Ordering::Relaxed);
+                }
+            });
+        }
+        loop {
+            if let Some(e) = error.lock().unwrap().as_ref() {
+                return Err(e.clone().into());
+            }
+            let current = tick.load(Ordering::Relaxed);
+            progress.download(current.min(total), total);
+            if current >= total && next.load(Ordering::Relaxed) >= files.len() {
+                return Ok(());
+            }
+            std::thread::sleep(Duration::from_millis(120));
+        }
+    })?;
+    if let Some(e) = error.into_inner().unwrap() {
+        return Err(e.into());
+    }
+    progress.report("extract", 0, 0);
+
+    // Assemble the resources root in a staging directory, then activate it
+    // atomically: engine tables from the bundle, vanilla `assets/` + `data/`
+    // from the verified client jar, and the asset objects under `assets/`.
+    let staging = home.join(".resources-install-partial");
+    if staging.exists() {
+        fs::remove_dir_all(&staging)?;
+    }
+    fs::create_dir(&staging)?;
+    let result = (|| -> Result<()> {
+        extract_zip_into(
+            fs::File::open(&staged_tables)?,
+            &staging,
+            &[],
+        )?;
+        extract_zip_into(
+            fs::File::open(&client.path)?,
+            &staging,
+            &["assets/", "data/"],
+        )?;
+        for (name, from) in assets {
+            let path = staging.join("assets").join(relative(name)?);
+            fs::create_dir_all(path.parent().ok_or("Missing asset parent")?)?;
+            fs::copy(from, path)?;
+        }
+        if !staging.join("horizon-resources.json").is_file() {
+            return Err("Engine tables bundle has no horizon-resources.json".into());
+        }
+        // The runtime reads the asset index next to the tables (same file the
+        // PC preparation writes), decoded from the verified download.
+        fs::write(
+            staging.join("asset-index.json"),
+            serde_json::to_vec(&index)?,
+        )?;
+        Ok(())
+    })();
+    if let Err(e) = result {
+        let _ = fs::remove_dir_all(&staging);
+        return Err(e);
+    }
+
+    progress.report("finalize", 0, 0);
+    let destination = home.join("resources");
+    let backup = home.join("resources.previous");
+    if backup.exists() {
+        fs::remove_dir_all(&backup)?;
+    }
+    if destination.exists() {
+        fs::rename(&destination, &backup)?;
+    }
+    if let Err(error) = fs::rename(&staging, &destination) {
+        if backup.exists() {
+            let _ = fs::rename(&backup, &destination);
+        }
+        return Err(format!("Could not activate installed resources: {error}").into());
+    }
+    log::info!(
+        "Official resources for Minecraft {version} installed to {}",
+        destination.display()
+    );
+
+    // Housekeeping: the verified downloads are no longer needed.
+    let _ = fs::remove_dir_all(&cache);
+    Ok(())
+}
