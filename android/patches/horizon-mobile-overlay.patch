+
+    /// Keeps the Android system keyboard (IME) in step with the focused
+    /// text field: raised while any field is focused (its text arrives
+    /// through the same `WindowEvent::KeyboardInput` path a physical
+    /// keyboard uses), lowered otherwise. Only acts on transitions, so a
+    /// manually closed IME is not fought. Sticky panel modifiers are
+    /// dropped as soon as the mini panel is hidden.
+    fn sync_mobile_keyboard(&mut self, state: &mut MobileTouchState) {
+        let active = self.mobile_text_input_active();
+        if active != state.osk_ime {
+            if let Some(w) = &self.window {
+                w.set_ime_allowed(active);
+            }
+            state.osk_ime = active;
+        }
+        if !state.osk_open
+            && (self.keys.contains(&KeyCode::ControlLeft)
+                || self.keys.contains(&KeyCode::AltLeft))
+        {
+            self.mobile_keyboard_clear_mods();
+        }
+    }
+
+    /// Routes a touch on the mini side keyboard panel. Returns true when
+    /// the touch was consumed: everything inside the panel is a key (or a
+    /// tab switch) and never reaches the game underneath; taps outside the
+    /// panel pass through untouched, so the game stays fully usable while
+    /// the panel is open.
+    fn mobile_panel_touch(&mut self, touch: &Touch, gx: f32, gy: f32, sw: f32, sh: f32) -> bool {
+        let Ok(mut state) = TOUCH_STATE.lock() else {
+            return false;
+        };
+        if !state.osk_open {
+            return false;
+        }
+        let layout = panel_layout(sw, sh);
+        let inside = gx >= layout.x0
+            && gx <= layout.x0 + layout.width
+            && gy >= layout.y0
+            && gy <= layout.y0 + layout.height;
+        if !inside {
+            return false;
+        }
+        if touch.phase == TouchPhase::Started {
+            let tabs_y = layout.y0 + layout.pad;
+            if gy < tabs_y + layout.tabs_h {
+                // The tab strip: F / abc / 123 / x (close).
+                let cells = 4.0;
+                let tw = (layout.width - 2.0 * layout.pad) / cells;
+                let idx = (((gx - layout.x0 - layout.pad) / tw).floor() as usize).min(3);
+                match idx {
+                    0 => state.osk_tab = OskTab::Func,
+                    1 => state.osk_tab = OskTab::Letters,
+                    2 => state.osk_tab = OskTab::Digits,
+                    _ => {
+                        state.osk_open = false;
+                        self.mobile_keyboard_clear_mods();
+                    }
+                }
+            } else if let Some(key) = panel_key_at(&layout, state.osk_tab, gx, gy) {
+                osk_press_key(&mut state, key);
+            }
+        }
+        true
+    }
+
+    /// Draws the mini side keyboard panel docked to the right edge: a tab
+    /// strip (F / abc / 123 / x) over the active tab's compact key grid, in
+    /// the same translucent HUD style as the rest of the mobile controls.
+    /// All sizes derive from the actual GUI width — nothing is hardcoded
+    /// for a particular phone.
+    fn draw_mobile_panel(&self, batch: &mut HudBatch, atlas: &HudAtlas, state: &MobileTouchState) {
+        let layout = panel_layout(batch.width, batch.height);
+        let rows: &[OskRow] = match state.osk_tab {
+            OskTab::Func => &FUNC,
+            OskTab::Letters => &LETTERS,
+            OskTab::Digits => &DIGITS,
+        };
+        let quad = |x0: f32, y0: f32, w: f32, h: f32| {
+            [
+                [x0, y0],
+                [x0 + w, y0],
+                [x0 + w, y0 + h],
+                [x0, y0 + h],
+            ]
+        };
+
+        // Panel background.
+        batch.fill_quad(
+            atlas,
+            quad(layout.x0, layout.y0, layout.width, layout.height),
+            rgba(16, 16, 16, 190),
+        );
+
+        // Tab strip: F / abc / 123 / x.
+        let tabs_y = layout.y0 + layout.pad;
+        let cells = 4.0;
+        let tw = (layout.width - 2.0 * layout.pad) / cells;
+        let tabs = ["F", "abc", "123", "x"];
+        for (i, label) in tabs.iter().enumerate() {
+            let x = layout.x0 + layout.pad + i as f32 * tw;
+            let active = matches!(
+                (i, state.osk_tab),
+                (0, OskTab::Func) | (1, OskTab::Letters) | (2, OskTab::Digits)
+            );
+            let fill = if active {
+                rgba(255, 255, 255, 130)
+            } else {
+                rgba(255, 255, 255, 55)
+            };
+            batch.fill_quad(atlas, quad(x, tabs_y, tw - layout.gap, layout.tabs_h), fill);
+            let lw = HudBatch::text_width(atlas, label);
+            batch.text(
+                atlas,
+                label,
+                x + (tw - layout.gap - lw) / 2.0,
+                tabs_y + layout.tabs_h / 2.0 - 4.0,
+                rgba(255, 255, 255, 230),
+                false,
+            );
+        }
+
+        // The active tab's keys.
+        let ctrl_on = self.keys.contains(&KeyCode::ControlLeft);
+        let alt_on = self.keys.contains(&KeyCode::AltLeft);
+        let keys_y = tabs_y + layout.tabs_h + layout.gap;
+        for (r, row) in rows.iter().enumerate() {
+            let y = keys_y + r as f32 * (layout.key_h + layout.gap);
+            let mut left = 0.0;
+            for (key, units) in row.iter() {
+                let x = layout.x0 + layout.pad + left * (layout.unit + layout.gap);
+                let w = units * layout.unit + (units - 1.0) * layout.gap;
+                left += units;
+
+                let lit = (matches!(key, OskKey::Shift) && state.osk_shift)
+                    || (matches!(key, OskKey::Mod(OskMod::Ctrl)) && ctrl_on)
+                    || (matches!(key, OskKey::Mod(OskMod::Alt)) && alt_on);
+                let fill = if lit {
+                    rgba(255, 255, 255, 130)
+                } else if matches!(key, OskKey::Char(_)) {
+                    rgba(255, 255, 255, 40)
+                } else {
+                    rgba(255, 255, 255, 70)
+                };
+                batch.fill_quad(atlas, quad(x, y, w, layout.key_h), fill);
+
+                let label = key.label(state.osk_shift);
+                let tw = HudBatch::text_width(atlas, &label);
+                batch.text(
+                    atlas,
+                    &label,
+                    x + (w - tw) / 2.0,
+                    y + layout.key_h / 2.0 - 4.0,
+                    rgba(255, 255, 255, 230),
+                    false,
+                );
+            }
+        }
+    }
+
+    /// Hands the keyboard's queued outputs to the engine: each one goes to
+    /// the focused text field (or, for special keys in gameplay, into the
+    /// physical keyboard's own path). Drained after every touch event, from
+    /// the `window_event` touch hook.
+    pub(crate) fn flush_mobile_keyboard(&mut self) {
+        let Ok(mut state) = TOUCH_STATE.lock() else {
+            return;
+        };
+        let mut queue = std::mem::take(&mut state.osk_queue);
+        drop(state);
+        for out in queue.drain(..) {
+            self.mobile_keyboard_output(out);
+        }
+    }
+
+    pub(crate) fn is_overlay_open(&self) -> bool {
+        self.book.is_some() || self.sign_edit.is_some()
+    }
+    /// Whether a text field is currently focused, so the Android on-screen
+    /// keyboard should show: the pad's typing screens (`pad_typing`) plus
+    /// the other screens' single text boxes (command block, world options,
+    /// dialogs, the title's caret fields).
+    pub(crate) fn mobile_text_input_active(&mut self) -> bool {
+        (self.screen == Screen::Chat && self.title.is_none())
+            || self.sign_edit.is_some()
+            || matches!(self.book, Some(books::BookScreen::Edit { .. }))
+            || (self.screen == Screen::Creative && self.creative_screen.tab().search)
+            || self.recipe_search_focused()
+            || self.station_typing()
+            || self.screen == Screen::CommandBlock
+            || self.dialog_open()
+            || self.screen == Screen::WorldOptions
+            || self.title.as_mut().is_some_and(|t| t.has_caret_field())
+    }
+    /// Routes one Android keyboard output (mini side panel or system IME)
+    /// into whatever text field has focus, with the same handlers a typed
+    /// physical key reaches (a mobile mirror of the pad's
+    /// `pad_osk_output`); special keys with no field go through the
+    /// physical keyboard's own gameplay path (debug keys, then keybinds).
+    pub(crate) fn mobile_keyboard_output(&mut self, out: crate::mobile::OskOut) {
+        use crate::mobile::{OskMod, OskOut};
+        match out {
+            OskOut::Mod(m) => {
+                let (key, bit) = match m {
+                    OskMod::Ctrl => (
+                        KeyCode::ControlLeft,
+                        winit::keyboard::ModifiersState::CONTROL,
+                    ),
+                    OskMod::Alt => (
+                        KeyCode::AltLeft,
+                        winit::keyboard::ModifiersState::ALT,
+                    ),
+                };
+                if self.keys.contains(&key) {
+                    self.mobile_keyboard_clear_mods();
+                } else {
+                    self.keys.insert(key);
+                    self.physical_keys.insert(key);
+                    self.modifiers = self.modifiers.union(bit);
+                }
+                return;
+            }
+            OskOut::Text(t) => self.mobile_keyboard_text(Some(&t), None),
+            OskOut::Backspace => self.mobile_keyboard_text(None, Some(KeyCode::Backspace)),
+            OskOut::Enter => self.mobile_keyboard_text(None, Some(KeyCode::Enter)),
+            OskOut::Key(key) => self.mobile_keyboard_text(None, Some(key)),
+        }
+    }
+    /// The field routing behind [`Self::mobile_keyboard_output`]: `text`
+    /// types into the focused field, `key` presses a key into it. With no
+    /// field focused, special keys behave like the physical keyboard's
+    /// gameplay path (F1 HUD, F3 debug, F5 view, F11 fullscreen, Esc, ...).
+    fn mobile_keyboard_text(&mut self, text: Option<&str>, key: Option<KeyCode>) {
+        use horizon_client::debug_keys::KeyAction;
+        let backspace = key == Some(KeyCode::Backspace);
+        if self.screen == Screen::Chat && self.title.is_none() {
+            match text {
+                Some(t) => self.chat_type(t),
+                None => self.chat_key_code(key.expect("a chat key"), None),
+            }
+        } else if self.sign_edit.is_some() {
+            self.sign_input(key, text);
+        } else if self.book.is_some() {
+            self.book_input(key, text);
+        } else if self.screen == Screen::Creative && self.creative_screen.tab().search {
+            if backspace {
+                self.creative_search_backspace(false);
+            } else if key == Some(KeyCode::Escape) {
+                let _ = self.key_pressed(KeyCode::Escape);
+            } else if key.is_none() {
+                self.creative_search_edit(text);
+            }
+        } else if self.recipe_search_focused() {
+            if key == Some(KeyCode::Escape) {
+                let _ = self.key_pressed(KeyCode::Escape);
+            } else if key.is_none() {
+                self.recipe_text(text, backspace);
+            }
+        } else if self.station_typing() {
+            if key == Some(KeyCode::Escape) {
+                let _ = self.key_pressed(KeyCode::Escape);
+            } else if key.is_none() {
+                self.station_text(text, backspace);
+            }
+        } else if self.screen == Screen::WorldOptions {
+            match key {
+                Some(KeyCode::Escape) => self.world_options_escape(),
+                _ => self.world_options_text(text),
+            }
+        } else if self.screen == Screen::CommandBlock {
+            self.command_block_input(key.expect("a command block key"), text);
+        } else if self.dialog_open() {
+            let result = match text {
+                Some(t) => {
+                    self.dialog_type(t);
+                    Ok(())
+                }
+                None => self.dialog_key(key.expect("a dialog key"), None, None),
+            };
+            if let Err(e) = result {
+                log::warn!("Horizon: on-screen keyboard: {e}");
+            }
+        } else if self.screen == Screen::Options {
+            let result = match text {
+                Some(t) => {
+                    self.ui.options.type_text(&self.gui.atlas, t);
+                    Ok(())
+                }
+                None => self.options_key(key.expect("an options key"), None),
+            };
+            if let Err(e) = result {
+                log::warn!("Horizon: on-screen keyboard: {e}");
+            }
+        } else if self.title.is_some() {
+            match key {
+                Some(KeyCode::Enter) => {
+                    if let Some(t) = self.title.as_mut() {
+                        t.confirm_edit();
+                    }
+                }
+                Some(KeyCode::Backspace) => self.title_edit(None, true),
+                Some(KeyCode::Escape) => {
+                    if let Some(t) = self.title.as_mut() {
+                        t.escape();
+                    }
+                    self.save_title_options();
+                }
+                Some(KeyCode::Tab) => {
+                    if let Some(t) = self.title.as_mut() {
+                        t.tab();
+                    }
+                }
+                _ => self.title_edit(text, false),
+            }
+        } else if let Some(key) = key {
+            // No field focused: a panel tap is a FULL physical keystroke —
+            // press (debug keys first, then keybinds) followed by the
+            // release a real keyboard always sends. The release is not
+            // optional: F3's overlay toggles on it and the debug modifier
+            // un-latches there — without it a later Esc ran as F3+Esc
+            // (the "Game Paused"-without-menu screen) and stayed consumed.
+            if !self.debug_key(key, KeyAction::Press) {
+                self.keys.insert(key);
+                let _ = self.key_pressed(key);
+            }
+            self.debug_key(key, KeyAction::Release);
+            self.keys.remove(&key);
+        }
+    }
+    /// Releases the sticky modifiers the mini panel set (Ctrl/Alt), so a
+    /// hidden panel never leaves the engine's key state stuck. Also drops
+    /// the debug-keys' F3 modifier latch, so a closed panel can never leave
+    /// Escape behaving like F3+Escape.
+    pub(crate) fn mobile_keyboard_clear_mods(&mut self) {
+        for key in [KeyCode::ControlLeft, KeyCode::AltLeft] {
+            self.keys.remove(&key);
+            self.physical_keys.remove(&key);
+        }
+        self.modifiers = self.modifiers.difference(
+            winit::keyboard::ModifiersState::CONTROL | winit::keyboard::ModifiersState::ALT,
+        );
+        self.debug_keys.modifier_down = false;
+        self.debug_keys.used_debug_key_as_modifier = false;
+    }
+    /// An Android touch press on an options screen: like
+    /// [`Self::options_mouse`] pressed (grabs buttons, sliders and
+    /// scrollbars), but reports whether the press hit an interactive
+    /// widget — a press on empty space becomes a touch scroll instead.
+    pub(crate) fn mobile_options_press(&mut self) -> bool {
+        // Binding a mouse button: the waiting grab consumes the press.
+        if self.options_waiting_for_key() {
+            if let Err(e) = self.options_bind_mouse(MouseButton::Left) {
+                log::warn!("Horizon: mobile options bind: {e}");
+            }
+            return true;
+        }
+        self.dragging = true;
+        let size = self.gui_size();
+        let framebuffer = self
+            .renderer
+            .as_ref()
+            .map_or([1280, 720], |r| {
+                [r.config.width as i32, r.config.height as i32]
+            });
+        let mut ui = std::mem::take(&mut self.ui.options);
+        let events = ui.click(
+            &mut self.settings,
+            &self.gui.atlas,
+            self.cursor.0,
+            self.cursor.1,
+            size,
+            framebuffer,
+            false,
+            false,
+        );
+        let hit = !events.is_empty() || ui.dragging.is_some() || ui.scrollbar_drag_y.is_some();
+        self.ui.options = ui;
+        if let Err(e) = self.handle_option_events(events) {
+            log::warn!("Horizon: mobile options press: {e}");
+        }
+        hit
+    }
+    /// An Android touch move over an options screen: sliders and
+    /// scrollbars follow the finger (only while a press holds them);
+    /// buttons never re-fire on movement.
+    pub(crate) fn mobile_options_drag(&mut self) {
+        if self.dragging
+            && let Err(e) = self.options_drag()
+        {
+            log::warn!("Horizon: mobile options drag: {e}");
+        }
+    }
+
+    /// The mobile on-screen keyboard's output for the command box: the same
+    /// key handling as `command_block_key`, without a winit event to hand
+    /// over (no edit shortcuts — the touch keyboard produces none).
+    pub(crate) fn command_block_input(&mut self, key: KeyCode, typed: Option<&str>) {
+        match key {
+            KeyCode::Escape => return self.close_command_block(),
+            KeyCode::Enter | KeyCode::NumpadEnter => {
+                if let Some(s) = self.command_block_screen.take() {
+                    self.set_command_block(&s);
+                }
+                return self.close_command_block();
+            }
+            _ => {}
+        }
+        let ctrl = self.keys.contains(&KeyCode::ControlLeft);
+        let shift = self.keys.contains(&KeyCode::ShiftLeft);
+        let consumed = {
+            let Some(s) = self.command_block_screen.as_mut() else {
+                return;
+            };
+            s.command.key(key, ctrl, shift)
+        };
+        if !consumed && !ctrl {
+            self.command_block_type(typed.unwrap_or(""));
+        }
+    }
+
+    /// Universal dispatcher for menu and GUI mouse clicks across all screens.
+    pub(crate) fn dispatch_menu_mouse(
+        &mut self,
+        pressed: bool,
+        button: MouseButton,
+        event_loop: Option<&ActiveEventLoop>,
+    ) -> Result<()> {
+        if self.link_prompt.is_some() {
+            if pressed && button == MouseButton::Left {
+                self.link_prompt_click();
+            }
+            return Ok(());
+        }
+        if self.server_packs.prompt.is_some() {
+            if pressed && button == MouseButton::Left {
+                self.pack_prompt_click()?;
+            }
+            return Ok(());
+        }
+        if self.dialog_open() {
+            if pressed && button == MouseButton::Left {
+                self.dialog_click()?;
+            }
+            return Ok(());
+        }
+        if self.screen == Screen::Win {
+            return Ok(());
+        }
+        if self.screen == Screen::Options {
+            if self.options_waiting_for_key() && pressed {
+                self.options_bind_mouse(button)?;
+            } else if matches!(button, MouseButton::Left | MouseButton::Right) {
+                self.options_mouse(
+                    pressed,
+                    button == MouseButton::Right,
+                )?;
+            }
+            return Ok(());
+        }
+        if self.title.is_some() && self.screen != Screen::Options {
+            if !pressed && button == MouseButton::Left {
+                if let Some(title) = &mut self.title {
+                    title.release();
+                    title.release_field();
+                }
+            } else if pressed && button == MouseButton::Left {
+                let size = self
+                    .renderer
+                    .as_ref()
+                    .map(|r| [r.config.width, r.config.height])
+                    .unwrap_or([1, 1]);
+                let b = HudBatch::new(size);
+                let atlas = &self.gui.atlas;
+                let shift = self.has_shift_down();
+                let (action, sound) = self.title.as_mut().map_or((Action::None, false), |t| {
+                    let clicked = t.click(self.cursor.0, self.cursor.1, (b.width, b.height));
+                    t.press_field(atlas, self.cursor, (b.width, b.height), shift);
+                    let rules = t.press_rules(atlas, self.cursor, (b.width, b.height));
+                    (clicked.0, clicked.1 || rules)
+                });
+                self.save_title_options();
+                if sound {
+                    self.audio.play_button_click();
+                }
+                match action {
+                    Action::Quit => {
+                        if let Some(el) = event_loop {
+                            el.exit();
+                        }
+                    }
+                    Action::Options => self.open_options(true),
+                    Action::Accessibility => self
+                        .open_options_at(true, horizon_client::options_ui::Page::Accessibility),
+                    Action::Language => {
+                        self.open_options_at(true, horizon_client::options_ui::Page::Language)
+                    }
+                    Action::Play { folder } => {
+                        self.open_world(&folder, None, None, false, None)?
+                    }
+                    Action::Create {
+                        folder,
+                        name,
+                        seed,
+                        creative,
+                        options,
+                    } => {
+                        self.open_world(&folder, Some(&name), seed, creative, Some(&options))?
+                    }
+                    Action::Connect { address } => {
+                        self.connect_server(&address, &self.options.player_name())?
+                    }
+                    Action::None => {}
+                }
+            }
+            return Ok(());
+        }
+        if self.title.is_some() {
+            return Ok(());
+        }
+        if self.book.is_some() {
+            if pressed && button == MouseButton::Left {
+                let size = self
+                    .renderer
+                    .as_ref()
+                    .map(|r| [r.config.width, r.config.height])
+                    .unwrap_or([1, 1]);
+                self.book_click(size);
+            }
+            return Ok(());
+        }
+        if self.sign_edit.is_some() {
+            if pressed && button == MouseButton::Left {
+                let size = self
+                    .renderer
+                    .as_ref()
+                    .map(|r| [r.config.width, r.config.height])
+                    .unwrap_or([1, 1]);
+                self.sign_edit_click(size);
+            }
+            return Ok(());
+        }
+        if matches!(self.screen, Screen::Inventory | Screen::Creative)
+            && let Some(key) = self
+                .settings
+                .keys
+                .container_mouse_key(button, self.creative)
+        {
+            if pressed && self.carried.is_none() {
+                self.inventory_hotkey(key);
+            }
+            return Ok(());
+        }
+        if pressed && self.sort_mouse_press(button) {
+            return Ok(());
+        }
+        match self.screen {
+            Screen::Inventory | Screen::Creative
+                if !matches!(button, MouseButton::Left | MouseButton::Right) =>
+            {
+                if self.settings.keys.get("key.pickItem")
+                    == horizon_client::keybinds::mouse_name(button)
+                {
+                    if pressed {
+                        self.inventory_pick_press();
+                    } else {
+                        self.inventory_pick_release();
+                    }
+                    if let Some(key) = self.container {
+                        self.container_changed(key);
+                    }
+                }
+            }
+            Screen::Inventory if pressed => {
+                self.inventory_press(button == MouseButton::Right);
+                if let Some(key) = self.container {
+                    self.container_changed(key);
+                }
+            }
+            Screen::Inventory => {
+                self.inventory_mouse_release(button == MouseButton::Right);
+                self.loom_release();
+            }
+            Screen::Chat if pressed && button == MouseButton::Left => self.chat_click(),
+            Screen::Creative if pressed => {
+                self.click_creative(button == MouseButton::Right);
+            }
+            Screen::Creative => {
+                if button == MouseButton::Left {
+                    self.creative_screen.release();
+                }
+                self.inventory_mouse_release(button == MouseButton::Right);
+            }
+            Screen::Paused
+                if pressed && button == MouseButton::Left && self.pause_menu =>
+            {
+                self.pause_click()?
+            }
+            Screen::WorldOptions if pressed && button == MouseButton::Left => {
+                self.world_options_click()
+            }
+            Screen::ServerLinks if pressed && button == MouseButton::Left => {
+                self.server_links_click()?
+            }
+            Screen::ConfirmLink if pressed && button == MouseButton::Left => {
+                self.confirm_link_click()
+            }
+            Screen::DialogWarning if pressed && button == MouseButton::Left => {
+                self.dialog_warning_click()?
+            }
+            Screen::WorldOptions if button == MouseButton::Left => {
+                self.world_options_release()
+            }
+            Screen::Friends if pressed && button == MouseButton::Left => {
+                self.friends_screen_click()
+            }
+            Screen::CommandBlock if pressed && button == MouseButton::Left => {
+                self.command_block_click()
+            }
+            Screen::Dead if pressed && button == MouseButton::Left => {
+                self.death_click()?
+            }
+            Screen::Advancements if button == MouseButton::Left => {
+                let size = self
+                    .renderer
+                    .as_ref()
+                    .map_or([1, 1], |r| [r.config.width, r.config.height]);
+                self.advancements_mouse(pressed, size);
+            }
+            Screen::Stats if pressed && button == MouseButton::Left => {
+                let size = self
+                    .renderer
+                    .as_ref()
+                    .map_or([1, 1], |r| [r.config.width, r.config.height]);
+                self.stats_click(size);
+            }
+            Screen::Stats if button == MouseButton::Left => self.stats_release(),
+            Screen::Mod if pressed => self.mod_screen_click(button),
+            _ => {}
+        }
+        Ok(())
+    }
+}
